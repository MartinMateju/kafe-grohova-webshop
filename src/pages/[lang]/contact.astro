---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allLangs, useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const email = 'ahoj@kafegrohova.cz';
const hours = lang === 'cs'
  ? ['Pondělí–pátek  07:00–17:00', 'Sobota–neděle  10:00–15:00']
  : ['Monday–Friday  07:00–17:00', 'Saturday–Sunday  10:00–15:00'];
const mapsUrl = 'https://maps.google.com/?q=Grohova+102/3,+602+00+Brno';
const copy = lang === 'cs' ? {
  title: 'Stavte se.', second: 'Nebo napište.',
  intro: 'Na kafe nás najdete na Grohové. S dotazem ke kurzům nebo čemukoliv dalšímu se ozvěte e-mailem.',
  directions: 'Ukázat cestu', question: 'Máte otázku?',
  social: 'Co se děje na Grohové', photo: 'Kávový kout v Kafe Grohova',
} : {
  title: 'Come by.', second: 'Or say hello.',
  intro: 'Find us on Grohova for a coffee. For questions about courses or anything else, drop us an email.',
  directions: 'Get directions', question: 'A question for us?',
  social: 'Life on Grohova', photo: 'A coffee corner at Kafe Grohova',
};
---

<BaseLayout title={t('contact.title')} description={copy.intro}>
  <div class="brand-page contact-page">
    <header class="contact-hero">
      <div class="contact-intro">
        <p class="section-kicker">{t('contact.title')} / BRNO</p>
        <h1 class="page-heading">{copy.title}<br /><span>{copy.second}</span></h1>
        <p class="editorial-intro">{copy.intro}</p>
        <a class="text-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">{copy.directions} <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="contact-photo">
        <img src="/photos/coffee-corner.webp" alt={copy.photo} width="960" height="1440" fetchpriority="high" />
        <figcaption>GROHOVA 102/3 · BRNO</figcaption>
      </figure>
    </header>

    <section class="visit-details" aria-label={t('contact.findUs')}>
      <div>
        <h2 class="section-kicker">{t('contact.address')}</h2>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Grohova 102/3<br />602 00 Brno <span aria-hidden="true">↗</span></a>
      </div>
      <div>
        <h2 class="section-kicker">{t('contact.openingHours')}</h2>
        {hours.map((line) => <p>{line}</p>)}
      </div>
      <div>
        <h2 class="section-kicker">E-mail</h2>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </section>

    <section class="contact-message" aria-labelledby="message-heading">
      <div class="message-intro">
        <p class="section-kicker">{t('contact.getInTouch')}</p>
        <h2 id="message-heading">{copy.question}</h2>
        <p class="editorial-intro">{t('contact.sub')}</p>
        <div class="social-link">
          <p class="section-kicker">{copy.social}</p>
          <a class="text-link" href="https://instagram.com/kafegrohova" target="_blank" rel="noopener noreferrer">@kafegrohova <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <form data-contact-form data-email={email} aria-describedby="contact-note">
        <p id="contact-note" class="form-note">{t('contact.note')}</p>
        <label>
          <span class="section-kicker">{t('contact.email')} *</span>
          <input type="email" name="email" autocomplete="email" required placeholder={lang === 'cs' ? 'vy@example.com' : 'you@example.com'} />
        </label>
        <label>
          <span class="section-kicker">{t('contact.subject')} *</span>
          <input type="text" name="subject" required />
        </label>
        <label>
          <span class="section-kicker">{t('contact.message')} *</span>
          <textarea name="message" required rows="5"></textarea>
        </label>
        <button type="submit">{t('contact.send')} <span aria-hidden="true">↗</span></button>
        <p data-contact-sent hidden role="status" class="form-note">{t('contact.sent')}</p>
      </form>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page { padding-block: clamp(2.5rem, 6vw, 6rem); }
  .contact-hero { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem, 6vw, 7rem); }
  .contact-intro { min-width: 0; }
  .contact-intro h1 { margin-block: 1.5rem 2rem; font-size: clamp(3rem, 6.6vw, 6.5rem); }
  .contact-intro h1 span { color: var(--color-brick); }
  .contact-intro .editorial-intro { max-width: 32rem; margin-bottom: 2rem; }
  .text-link { display: inline-flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; border-bottom: 1px solid currentColor; padding-bottom: .4rem; font-size: 1rem; }
  .text-link:hover, .visit-details a:hover { color: var(--color-brick); }
  .contact-photo { margin: 0; min-width: 0; }
  .contact-photo img { display: block; width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; }
  .contact-photo figcaption { padding-top: .75rem; font-family: var(--font-display); font-size: .75rem; letter-spacing: .1em; }
  .visit-details { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2rem; margin-block: clamp(3rem, 7vw, 7rem); padding-block: 2rem; border-block: 1px solid color-mix(in srgb, var(--color-ink) 25%, transparent); }
  .visit-details h2 { margin-bottom: 1rem; }
  .visit-details a, .visit-details p { font-size: clamp(1.05rem, 1.6vw, 1.4rem); line-height: 1.6; overflow-wrap: anywhere; }
  .contact-message { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(2.5rem, 7vw, 8rem); }
  .message-intro h2 { font-family: var(--font-sans); font-weight: 700; letter-spacing: -.055em; font-size: clamp(2.5rem, 4vw, 4rem); line-height: 1.05; margin-block: 1rem 1.5rem; }
  .social-link { margin-top: 3rem; }
  .social-link .section-kicker { margin-bottom: 1rem; }
  form { display: flex; flex-direction: column; gap: 1.8rem; min-width: 0; }
  .form-note { font-size: .9rem; line-height: 1.65; max-width: 38rem; }
  label { display: flex; flex-direction: column; gap: .8rem; }
  input, textarea { width: 100%; border: 0; border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 45%, transparent); border-radius: 0; background: transparent; padding: .7rem 0; font: inherit; font-size: 1rem; color: var(--color-ink); }
  textarea { resize: vertical; min-height: 8rem; }
  input:focus, textarea:focus { border-color: var(--color-brick); }
  button[type='submit'] { align-self: flex-start; display: inline-flex; gap: 2rem; justify-content: space-between; border: 1px solid var(--color-brick); background: var(--color-brick); color: var(--color-cream); padding: 1rem 1.5rem; font-family: var(--font-display); font-size: .8rem; letter-spacing: .08em; cursor: pointer; }
  button[type='submit']:hover { background: var(--color-ink); border-color: var(--color-ink); }
  @media (max-width: 760px) { .contact-hero, .contact-message { grid-template-columns: 1fr; } .contact-intro h1 { font-size: clamp(2.75rem, 11.5vw, 5rem); } .contact-photo img { aspect-ratio: 4 / 3; object-position: center 38%; } .visit-details { grid-template-columns: 1fr; gap: 1.8rem; } .social-link { margin-top: 2rem; } }
</style>

<script>
  // This static form opens a draft; the visitor sends it from their email app.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const to = form.dataset.email ?? '';
    const subject = encodeURIComponent(String(data.get('subject') ?? ''));
    const body = encodeURIComponent(`${String(data.get('message') ?? '')}\n\n— ${String(data.get('email') ?? '')}`);
    window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    const sent = form.querySelector<HTMLElement>('[data-contact-sent]');
    if (sent) sent.hidden = false;
  });
</script>
