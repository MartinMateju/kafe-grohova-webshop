---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AddToCart from '../../../components/AddToCart.astro';
import CourseVoucherArtwork from '../../../components/CourseVoucherArtwork.astro';
import { localizedPaths } from '../../../i18n/paths';
import { allLangs, localePath, type Lang } from '../../../i18n/utils';
import { getGiftCards, GIFT_CARDS_ENABLED, type Product, formatMoney, imageUrl, isMockMode } from '../../../lib/shopify';
import { isLatteArtGiftCard, resolveLatteArtGiftCard } from '../../../lib/coursePresentation';
export async function getStaticPaths() {
  if (!GIFT_CARDS_ENABLED) return [];
  const paths: Array<{ params: { lang: Lang; handle: string }; props: { item: Product | null; alternatePaths: Record<string, string> } }> = await localizedPaths(getGiftCards, 'gift-cards');
  for (const lang of allLangs) {
    if (!paths.some(path => path.params.lang === lang && path.params.handle === 'poukaz-latte-art')) {
      paths.push({ params: { lang, handle: 'poukaz-latte-art' }, props: { item: null, alternatePaths: Object.fromEntries(allLangs.map(locale => [locale, localePath(locale, '/gift-cards/poukaz-latte-art')])) } });
    }
  }
  return paths;
}
const lang = Astro.params.lang as Lang;
const cs = lang === 'cs';
const { item: original, alternatePaths } = Astro.props;
const courseVoucher = !original || isLatteArtGiftCard(original);
const product = original && courseVoucher ? resolveLatteArtGiftCard([original]) : original;
const title = courseVoucher ? (cs ? 'Poukaz na Latte art pro začátečníky.' : 'Beginner latte art gift voucher.') : product?.title ?? '';
const descriptionHtml = product?.descriptionHtml ?? '';
const previewImage = imageUrl(product?.featuredImage?.url, 1200) || '/gift-card-preview.png';
---
<BaseLayout alternatePaths={alternatePaths} title={title} description={courseVoucher ? (cs ? 'Dárkový poukaz v hodnotě 2 100 Kč na osobu. Termín si obdarovaný vybere později.' : 'A gift voucher worth CZK 2,100 per person. The recipient chooses a date later.') : product?.description.slice(0,160) ?? ''} image={courseVoucher ? '/photos/latte-on-table.webp' : previewImage}>
  <div class="brand-page gift-detail"><a href={localePath(lang, '/gift-cards')} class="gift-back">← {cs ? 'Dárkové poukazy' : 'Gift vouchers'}</a><div class="gift-detail-grid"><div class="gift-visual"><div class="gift-art-panel">{courseVoucher ? <CourseVoucherArtwork lang={lang} /> : <img src={previewImage} alt={product?.featuredImage?.altText ?? title} class="aspect-[1.414] w-full object-contain" />}</div>{!courseVoucher && <a href="/downloads/gift-card-sample.pdf" target="_blank" rel="noopener" data-gift-preview class="gift-preview-link">{cs ? 'Prohlédnout ukázku poukazu (PDF)' : 'Preview the sample voucher (PDF)'} ↗</a>}<p class="gift-preview-note">{cs ? 'Ukázka vzhledu. Neobsahuje platný dárkový kód a nelze ji uplatnit.' : 'A design preview only. It contains no valid gift code and cannot be redeemed.'}</p></div><div class="gift-purchase"><p class="section-kicker">{courseVoucher ? (cs ? 'Zážitek pro jednoho' : 'An experience for one') : (cs ? 'Hodnotový poukaz' : 'Monetary gift card')}</p><h1 class="page-heading">{title}</h1><p class="gift-lead">{courseVoucher ? (cs ? 'Nová dovednost, vlastní první srdce a čas za barem. Termín si obdarovaný vybere později podle dostupné nabídky.' : 'A new skill, a first heart and time behind the bar. The recipient chooses a date later from available sessions.') : (cs ? 'Vyberte hodnotu a nechte další rozhodnutí na obdarovaném.' : 'Choose a value and leave the next decision to them.')}</p><p class="gift-detail-price"><span data-product-price aria-live="polite">{product ? formatMoney(product.priceRange.minVariantPrice, lang) : '2 100 Kč'}</span>{courseVoucher && <span> / {cs ? 'osoba' : 'person'}</span>}</p>{product ? <AddToCart product={product} lang={lang} /> : <div class="gift-unavailable"><p>{cs ? 'Online prodej tohoto poukazu připravujeme. Napište nám a s objednávkou vám rádi poradíme.' : 'Online sales of this voucher are being prepared. Contact us for help ordering.'}</p><a href={localePath(lang, '/contact')}>{cs ? 'Poptat poukaz' : 'Enquire about a voucher'} ↗</a></div>}{isMockMode && <p data-gift-demo class="gift-demo">{cs ? 'Ukázkový e-shop: můžete vyzkoušet košík. Platba i vydání platného dárkového kódu jsou vypnuté.' : 'Demo storefront: try the cart. Payment and redeemable gift-code issuance are disabled.'}</p>}{!courseVoucher && descriptionHtml && <div class="rte gift-description" set:html={descriptionHtml} />}</div></div>
    <section class="gift-explained"><div><p class="section-kicker">{cs ? 'Až se dárek rozbalí' : 'After the gift is opened'}</p><h2>{cs ? 'Jak to celé' : 'How it'}<br />{cs ? 'funguje.' : 'works.'}</h2></div><ol><li><span>01</span><div><h3>{cs ? 'Kód přijde e-mailem.' : 'The code arrives by email.'}</h3><p>{cs ? 'Po zaplacení a vyřízení objednávky dostanete jedinečný dárkový kód. Obrázek poukazu na této stránce je pouze ukázka.' : 'After payment and fulfilment, you receive a unique gift code. The voucher image on this page is only a preview.'}</p></div></li><li><span>02</span><div><h3>{cs ? 'Obdarovaný vybere termín.' : 'They choose a date.'}</h3><p>{cs ? 'Kurz se rezervuje zvlášť podle dostupných míst. Samotný poukaz neblokuje místo na 25. listopadu ani na jiný termín.' : 'A course is booked separately, subject to availability. The voucher does not hold a place on 25 November or any other date.'}</p></div></li><li><span>03</span><div><h3>{cs ? 'Hodnota se uplatní v pokladně.' : 'Redeem the value at checkout.'}</h3><p>{cs ? 'Dárkový kód se zadává při objednávce. Případný rozdíl mezi hodnotou poukazu a cenou objednávky se dořeší v pokladně.' : 'Enter the gift code when ordering. Any difference between the voucher value and order total is handled at checkout.'}</p></div></li></ol></section>
    {courseVoucher && <a class="gift-course-link" href={localePath(lang, '/courses')}>{cs ? 'Prohlédnout kurzy a dostupný termín' : 'Explore courses and the available session'} ↗</a>}
  </div>
</BaseLayout>
<style>
.gift-back{display:inline-block;margin-bottom:35px;border-bottom:1px solid #29211d35;padding-bottom:7px;font-size:13px}.gift-detail-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(30px,6vw,80px);align-items:start}.gift-art-panel{background:#dfd0ba;padding:clamp(18px,3vw,38px)}.gift-purchase .page-heading{font-size:clamp(36px,4.4vw,65px);line-height:1.04;margin:25px 0}.gift-lead,.gift-description{font:17px/1.65 var(--font-sans);max-width:450px}.gift-detail-price{font-size:30px;margin:26px 0}.gift-detail-price>span:last-child:not([data-product-price]){font-size:14px}.gift-preview-note{font:12px/1.6 var(--font-sans);opacity:.7;margin-top:20px;max-width:400px}.gift-preview-link{display:inline-block;margin-top:20px;border-bottom:1px solid currentColor;padding-bottom:6px;font-size:13px}.gift-demo{font:12px/1.6 var(--font-sans);border-left:2px solid #9f4a34;padding-left:15px;margin-top:24px}.gift-unavailable{padding:22px;border:1px solid #29211d40;font:15px/1.6 var(--font-sans)}.gift-unavailable a{display:inline-block;padding:12px 0 5px;border-bottom:1px solid currentColor}.gift-description{margin-top:30px;border-top:1px solid #29211d40;padding-top:25px}.gift-explained{display:grid;grid-template-columns:1fr 1.2fr;gap:70px;padding-top:45px;margin-top:85px;border-top:1px solid #29211d40}.gift-explained h2{font:600 clamp(36px,4.5vw,64px)/1.05 var(--font-sans);letter-spacing:-.05em;margin-top:25px}.gift-explained ol{list-style:none;padding:0;margin:0}.gift-explained li{display:flex;gap:25px;margin-bottom:28px}.gift-explained li>span{font-size:12px;color:#9f4a34;padding-top:4px}.gift-explained h3{font:700 20px/1.2 var(--font-sans);letter-spacing:-.025em;margin-bottom:12px}.gift-explained li p{font:15px/1.7 var(--font-sans)}.gift-course-link{display:inline-block;border-bottom:1px solid currentColor;padding-bottom:7px;margin-top:15px;font-size:13px}
@media(max-width:700px){.gift-detail-grid,.gift-explained{grid-template-columns:1fr;gap:35px}.gift-art-panel{padding:17px}.gift-purchase .page-heading{font-size:40px}.gift-explained{margin-top:55px}.gift-explained h2{margin-top:20px}}
</style>
