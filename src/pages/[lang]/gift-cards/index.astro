---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CourseVoucherArtwork from '../../../components/CourseVoucherArtwork.astro';
import { allLangs, localePath, type Lang } from '../../../i18n/utils';
import { getGiftCards, GIFT_CARDS_ENABLED, isMockMode } from '../../../lib/shopify';
import { isLatteArtGiftCard, resolveLatteArtGiftCard } from '../../../lib/coursePresentation';
export function getStaticPaths() { return allLangs.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const cs = lang === 'cs';
const gifts = await getGiftCards(lang);
const courseGift = resolveLatteArtGiftCard(gifts);
const otherGifts = gifts.filter(gift => !isLatteArtGiftCard(gift));
---
<BaseLayout title={cs ? 'Dárkové poukazy' : 'Gift vouchers'} description={cs ? 'Darujte první srdce do kávy. Poukaz na Latte art pro začátečníky v hodnotě 2 100 Kč za osobu.' : 'Give them their first coffee heart. A beginner latte art voucher worth CZK 2,100 per person.'}>
  <div class="brand-page gifts-page"><header class="gifts-header"><p class="section-kicker">{cs ? 'Kafe Grohova / Dárkové poukazy' : 'Kafe Grohova / Gift vouchers'}</p><h1 class="page-heading">{cs ? 'Darujte' : 'Give them'}<br />{cs ? 'první srdce.' : 'their first heart.'}</h1><p class="editorial-intro">{cs ? 'Dárek, který se nenaučí ležet v šuplíku. Konvička, mléko a nový zážitek za barem.' : 'A gift made for more than a drawer. A pitcher, some milk and a new experience behind the bar.'}</p></header>
    {GIFT_CARDS_ENABLED ? <>
    <section class="featured-voucher" data-gift-card="poukaz-latte-art"><div class="voucher-display"><CourseVoucherArtwork lang={lang} /></div><div class="voucher-intro"><p class="section-kicker">{cs ? 'Jeden kurz. Nový začátek.' : 'One course. A new beginning.'}</p><h2>{cs ? 'Latte art' : 'Latte art'}<br />{cs ? 'pro začátečníky.' : 'for beginners.'}</h2><p>{cs ? 'Poukaz v hodnotě kurzu pro jednu osobu. Obdarovaný si termín vybere později podle dostupných míst.' : 'A voucher worth one course place. The recipient chooses a date later, subject to availability.'}</p><p class="voucher-price">2 100 Kč <span>{cs ? '/ osoba' : '/ person'}</span></p><a class="voucher-cta" href={localePath(lang, '/gift-cards/' + (courseGift?.handle ?? 'poukaz-latte-art'))}>{cs ? 'Prohlédnout poukaz' : 'Explore the voucher'} <span aria-hidden="true">↗</span></a>{!courseGift && <p class="voucher-note">{cs ? 'Online prodej tohoto poukazu připravujeme. S objednávkou vám rádi poradíme.' : 'Online sales of this voucher are being prepared. Get in touch for help ordering.'}</p>}{isMockMode && <p class="voucher-note" data-gift-demo>{cs ? 'Ukázkový e-shop: platba a vydání platného dárkového kódu jsou vypnuté.' : 'Demo storefront: payment and redeemable gift-code issuance are disabled.'}</p>}</div></section>
    <section class="gifting-steps"><p class="section-kicker">{cs ? 'Od dárku k prvnímu nalití' : 'From a gift to a first pour'}</p><ol><li><span>01</span><h3>{cs ? 'Vyberte poukaz.' : 'Choose a voucher.'}</h3><p>{cs ? 'Jedna osoba, jeden nový zážitek. Zvolená hodnota je uvedená před nákupem.' : 'One person, one new experience. The selected value is shown before purchase.'}</p></li><li><span>02</span><h3>{cs ? 'Darujte radost.' : 'Give a little joy.'}</h3><p>{cs ? 'Po zaplacení a vyřízení objednávky přijde dárkový kód e-mailem.' : 'After payment and fulfilment, the gift code arrives by email.'}</p></li><li><span>03</span><h3>{cs ? 'Termín až potom.' : 'Choose a date later.'}</h3><p>{cs ? 'Obdarovaný si vybere vypsaný termín a uplatní kód v pokladně. Poukaz sám místo nerezervuje.' : 'The recipient chooses an available session and redeems the code at checkout. A voucher does not reserve a seat.'}</p></li></ol></section>
    {otherGifts.length > 0 && <section class="other-vouchers"><div><p class="section-kicker">{cs ? 'Chcete nechat výběr na nich?' : 'Let them choose?'}</p><h2>{cs ? 'Poukaz na hodnotu.' : 'A gift of choice.'}</h2><p>{cs ? 'Další dostupné hodnotové poukazy. Jejich částka není cenou jednoho místa na kurzu.' : 'Other available monetary gift cards. Their values are not the price of a single course place.'}</p></div><div class="other-voucher-grid">{otherGifts.map(gift => <article data-gift-card={gift.handle}><ProductCard product={gift} lang={lang} section="gift-cards" heightClass="aspect-[1.414] h-auto" /><a href={localePath(lang, '/gift-cards/' + gift.handle)} class="other-voucher-link">{cs ? 'Vybrat hodnotu' : 'Choose a value'} ↗</a></article>)}</div></section>}
    </> : <p>{cs ? 'Dárkové poukazy jsou momentálně nedostupné.' : 'Gift vouchers are currently unavailable.'}</p>}
  </div>
</BaseLayout>
<style>
.gifts-header{margin-bottom:60px}.gifts-header .editorial-intro{max-width:500px;margin:25px 0 0 auto}.featured-voucher{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(30px,6vw,90px);align-items:center}.voucher-display{background:#dfd0ba;padding:clamp(18px,3vw,40px)}.voucher-intro h2,.other-vouchers h2{font:600 clamp(34px,4vw,60px)/1.06 var(--font-sans);letter-spacing:-.05em;margin:22px 0}.voucher-intro>p:not(.section-kicker):not(.voucher-price):not(.voucher-note),.other-vouchers>div>p:not(.section-kicker){font:17px/1.65 var(--font-sans);max-width:430px}.voucher-price{font-size:30px;margin:25px 0}.voucher-price span{font-size:14px}.voucher-cta{display:inline-flex;align-items:center;justify-content:space-between;gap:50px;background:#9f4a34;color:#f3e8d9;padding:17px 24px;font-size:13px;text-transform:uppercase;letter-spacing:.04em}.voucher-cta:hover{background:#29211d}.voucher-cta span{font:24px var(--font-sans)}.voucher-note{font:12px/1.5 var(--font-sans);margin-top:18px;max-width:410px;opacity:.75}.gifting-steps{border-top:1px solid #29211d40;padding-top:40px;margin-top:90px}.gifting-steps ol{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;list-style:none;margin-top:30px;padding:0}.gifting-steps li>span{font-size:13px;color:#9f4a34}.gifting-steps h3{font:700 22px/1.15 var(--font-sans);letter-spacing:-.025em;margin:20px 0 15px}.gifting-steps li p{font:15px/1.65 var(--font-sans)}.other-vouchers{display:grid;grid-template-columns:1fr 1.1fr;gap:65px;border-top:1px solid #29211d40;padding-top:50px;margin-top:80px}.other-voucher-grid{display:grid;gap:30px}.other-voucher-link{display:inline-block;font-size:13px;border-bottom:1px solid currentColor;padding:16px 0 7px}
@media(max-width:700px){.featured-voucher,.other-vouchers{grid-template-columns:1fr;gap:35px}.gifts-header{margin-bottom:35px}.gifting-steps{margin-top:55px}.gifting-steps ol{grid-template-columns:1fr;gap:30px}.gifting-steps li{border-bottom:1px solid #29211d25;padding-bottom:25px}.other-vouchers{margin-top:55px}.voucher-display{padding:16px}}
</style>
