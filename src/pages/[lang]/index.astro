---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeNavigation from '../../components/HomeNavigation.astro';
import HomeFooter from '../../components/HomeFooter.astro';
import { localePath, type Lang } from '../../i18n/utils';
import { GIFT_CARDS_ENABLED, MERCH_ENABLED } from '../../lib/shopify/config';
import '../../styles/homepage.css';
export function getStaticPaths() { return [{ params: { lang: 'cs' } }, { params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Lang;
const c = (cs: string, en: string) => lang === 'cs' ? cs : en;
const Category = MERCH_ENABLED ? 'a' : 'figure';
const categories = [
  { key: 'ceramics', src: '/photos/ceramics-hands.webp', width: 960, height: 1439, label: c('01 / Každý kousek jiný', '01 / No two alike'), title: c('Z ruky do ruky.', 'Made by hand.'), alt: c('Ručně vyrobené hrnky před výlohou Kafe Grohova.', 'Handmade cups outside the Kafe Grohova window.') },
  { key: 'coffee', src: '/images/OLD03329.webp', width: 2000, height: 1333, label: c('02 / Malé každodenní rituály', '02 / Little daily rituals'), title: c('Vaše obvyklé?', 'The usual?'), alt: c('Balíčky kávy a keramické hrnky na polici v Kafe Grohova.', 'Bags of coffee and ceramic cups on a shelf at Kafe Grohova.') },
  { key: 'details', src: '/photos/ceramics-stack.webp', width: 960, height: 1440, label: c('03 / Věci s charakterem', '03 / Things with character'), title: c('Tak trochu svoje.', 'A little different.'), alt: c('Barevné keramické hrnky naskládané na sobě.', 'Colourful handmade ceramic cups stacked together.') },
];
const artists = ['The Cure', 'Smashing Pumpkins', 'R.E.M.', 'Blur', 'The Stone Roses', 'Depeche Mode', 'Moby', 'David Bowie', 'The Frames'];
---
<BaseLayout fullBleed title={c('Espresso bar & store v Brně', 'Espresso bar & store in Brno')}>
  <HomeNavigation slot="navigation" lang={lang} />
  <div class="home-editorial">
    <section class="hero" aria-labelledby="hero-title">
      <picture class="hero-picture">
        <source media="(max-width: 600px)" srcset="/photos/grohova-friends-640.webp 640w, /photos/grohova-friends.webp 1280w" sizes="100vw" />
        <img src="/photos/grohova-street.webp" srcset="/photos/grohova-street-1280.webp 1280w, /photos/grohova-street.webp 1920w" sizes="100vw" width="1920" height="1280" fetchpriority="high" alt={c('Lidé a každodenní život před kavárnou Kafe Grohova.', 'People and everyday life outside Kafe Grohova.')} />
      </picture>
      <div class="hero-topline section-kicker"><span>Espresso bar & store</span><span>Grohova 102/3 · Brno</span></div>
      <div class="hero-bottom">
        <p class="section-kicker">{c('Vaše malá zastávka ve městě.', 'Your little stop in the city.')}</p>
        <h1 id="hero-title" lang="en"><span>brno is a</span><span>lifestyle<span class="hero-dot">.</span></span></h1>
        <a class="hero-sublink" href="#about">{c('Malý bar. Vlastní svět.', 'Small bar. A world of its own.')}<span aria-hidden="true">↘</span></a>
      </div>
    </section>

    <section class="home-intro" id="about" aria-labelledby="intro-title">
      <div class="home-section-label section-kicker"><span>01 / Kafe Grohova</span><span>{c('Místo s vlastním rytmem', 'A place with its own rhythm')}</span></div>
      <div class="intro-grid">
        <h2 id="intro-title" class="intro-title">
          <span class="intro-lead">{c('Brno po svým.', 'Brno, your way.')}</span>{' '}
          <em class="intro-reply">{c('Nikdy s davem.', 'Never follow the crowd.')}</em>
        </h2>
        <div class="intro-copy"><p>{c('Ranní espresso. Známá tvář za barem. Hrnek, který není jako ostatní. Jsme Kafe Grohova — malý espresso bar a store v Brně, kde mají dobré věci svoje místo.', 'Morning espresso. A familiar face behind the bar. A cup like no other. We are Kafe Grohova — a small espresso bar and store in Brno, with a place for the good things.')}</p><a class="home-text-link" href={localePath(lang, '/contact')}>{c('Potkáme se na Grohově', 'Meet us on Grohova')} ↗</a></div>
      </div>
      <div class="life-photos">
        <figure><img src="/photos/coffee-friends.webp" width="960" height="1440" alt={c('Chvíle u kávy v Kafe Grohova.', 'A moment over coffee at Kafe Grohova.')} loading="lazy" /><figcaption class="section-kicker">{c('Kafe je jen začátek.', 'Coffee is just the beginning.')}</figcaption></figure>
        <figure><img src="/images/OLD03342.webp" width="2000" height="3000" alt={c('Káva a sklenice vody na baru vedle zelené rostliny.', 'Coffee and a glass of water beside a plant on the counter.')} loading="lazy" /><figcaption class="section-kicker">{c('Pro chvíle mezi tím.', 'For the moments in between.')}</figcaption></figure>
        <figure><img src="/photos/street-window.webp" width="960" height="1440" alt={c('Výloha Kafe Grohova s odrazy stromů a útulným posezením u okna.', 'Kafe Grohova’s window with reflections of trees and a cosy window seat.')} loading="lazy" /><figcaption class="section-kicker">{c('Tady a teď. Na Grohově.', 'Here and now. On Grohova.')}</figcaption></figure>
      </div>
    </section>

    <section class="home-course" id="courses" aria-labelledby="course-title">
      <div class="course-photo"><img src="/photos/latte-pour.webp" width="960" height="1440" alt={c('Nalévání mléka do kávy a vznikající latte art.', 'Pouring milk into coffee to create latte art.')} loading="lazy" /><span class="section-kicker">02 / {c('Za barem jste vy', 'Your turn behind the bar')}</span></div>
      <div class="course-copy"><p class="section-kicker">{c('Latte art pro začátečníky', 'Latte art for beginners')}</p><h2 id="course-title" lang="en">
        <span class="course-line"><span class="course-step" aria-hidden="true">01</span>pour.</span>
        <span class="course-line"><span class="course-step" aria-hidden="true">02</span><em>practice.</em></span>
        <span class="course-line"><span class="course-step" aria-hidden="true">03</span>repeat.</span>
      </h2><p class="course-description">{c('Od prvního správně našlehaného mléka k vlastnímu srdci v šálku. Malá skupina, ruce na konvičce a prostor zkoušet.', 'From your first silky milk to a heart in the cup. A small group, hands on the pitcher, and room to practise.')}</p><div class="home-course-meta"><span>25. 11. 2026 · 17:00</span><span>{c('2,5 hodiny · 2 100 Kč / osoba', '2.5 hours · CZK 2,100 / person')}</span></div><a class="courses home-button" href={localePath(lang, '/courses')}>{c('Chci za bar', 'Take me behind the bar')}<span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="home-objects" id="shop" aria-labelledby="objects-title">
      <div class="home-section-label section-kicker"><span>03 / Espresso bar & store</span><span>{c('Káva. Keramika. Každodennost.', 'Coffee. Ceramics. Everyday life.')}</span></div>
      <div class="objects-heading">
        <h2 id="objects-title" class="objects-title">
          <span class="objects-anchor"><span>{c('DOBRÝ', 'GOOD')}</span>{' '}<span>{c('VĚCI.', 'THINGS.')}</span></span>{' '}
          <em class="objects-reply"><span>{c('Mají', 'Have')}</span>{' '}<span>{c('své', 'their')}</span>{' '}<span>{c('místo.', 'place.')}</span></em>
        </h2>
        <p>{c('Máme rádi věci, na kterých je vidět lidská ruka. Šálky s charakterem. Kávu, ke které se vracíte. Prohlédněte si je naživo u nás na Grohově.', 'We like things with a human touch. Cups with character. Coffee you come back to. Come and see them in person on Grohova.')}</p>
      </div>
      <div class="object-grid">{categories.map(item => <Category data-home-category={item.key} class="object-item" href={MERCH_ENABLED ? localePath(lang, '/store') : undefined}><div class="object-image"><img src={item.src} width={item.width} height={item.height} alt={item.alt} loading="lazy" /></div><p class="section-kicker">{item.label}</p><h3>{item.title}</h3></Category>)}</div>
    </section>

    <section class="home-soundtrack" aria-labelledby="soundtrack-title">
      <div class="home-section-label section-kicker"><span>04 / {c('Na naší frekvenci', 'On our frequency')}</span><span>Side A / Side B</span></div>
      <h2 id="soundtrack-title" lang="en"><span>good coffee.</span><em>different</em><span>frequencies.</span></h2>
      <div class="soundtrack-bottom"><p>{c('Každé místo má svůj zvuk. Náš je trochu alternativní, trochu nostalgický. A nejlíp zní s kávou v ruce.', 'Every place has a sound. Ours is a little alternative, a little nostalgic. Best enjoyed with a coffee in hand.')}</p><div><p class="section-kicker">{c('Hudební inspirace', 'Musical inspiration')}</p><p class="artist-list">{artists.map((artist, i) => <><span>{artist}</span>{i < artists.length - 1 && <span aria-hidden="true"> / </span>}</>)}</p></div></div>
    </section>

    {GIFT_CARDS_ENABLED && <section class="home-gift" aria-labelledby="gift-title">
      <div class="gift-copy">
        <p class="section-kicker">05 / {c('Pro někoho vašeho', 'For someone you love')}</p>
        <h2 id="gift-title" class="gift-title">
          <span class="gift-title-lead">{c('Darujte', 'Give them')}</span>{' '}
          <span class="gift-title-reply"><span class="gift-title-bridge">{c('první', 'a first')}</span>{' '}<em>{c('srdce.', 'heart.')}</em></span>
        </h2>
        <p>{c('Dárkový poukaz na latte art pro začátečníky. Dvě a půl hodiny nových zkušeností, kávy a vlastních malých úspěchů.', 'A gift voucher for beginner latte art. Two and a half hours of new skills, coffee, and little victories.')}</p><span class="gift-price">{c('2 100 Kč / osoba', 'CZK 2,100 / person')}</span><a class="gift-tile home-text-link" href={localePath(lang, '/gift-cards')}>{c('Darovat kurz', 'Gift a course')} ↗</a>
      </div>
      <div class="gift-visual"><img src="/photos/latte-on-table.webp" width="960" height="1440" alt={c('Latte art v keramickém šálku na stole.', 'Latte art in a ceramic cup on a table.')} loading="lazy" /><div class="gift-paper" aria-hidden="true"><img src="/brand/logo-black.svg" width="120" height="47" alt="" /><span class="section-kicker">Gift a little Grohova</span><strong>LATTE<br /><em>ART.</em></strong><span class="section-kicker">2 100 Kč · 1 {c('osoba', 'person')}</span></div></div>
    </section>}
  </div>
  <HomeFooter slot="footer" lang={lang} />
</BaseLayout>
