---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeNavigation from '../../components/HomeNavigation.astro';
import HomeFooter from '../../components/HomeFooter.astro';
import { allLangs, localePath, useTranslations, type Lang } from '../../i18n/utils';
import { MERCH_ENABLED, GIFT_CARDS_ENABLED } from '../../lib/shopify/config';
import '../../styles/homepage.css';

export function getStaticPaths() {
  return allLangs.map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const copy = (cs: string, en: string) => lang === 'cs' ? cs : en;
const Category = MERCH_ENABLED ? 'a' : 'div';
const storeHref = MERCH_ENABLED ? localePath(lang, '/store') : undefined;
const categories = [
  {
    key: 'equipment', src: '/images/OLD03375.webp', width: 2000, height: 3000,
    alt: copy('Mletí kávy do páky v kavárně.', 'Coffee being ground into a portafilter at the café.'),
    eyebrow: copy('02 / Pro váš každodenní rituál', '02 / For your daily ritual'),
    title: [copy('Vybavení.', 'Equipment.')],
    label: copy('Dobrá káva začíná u detailů', 'Good coffee is in the details'),
  },
  {
    key: 'coffee', src: '/images/OLD03329.webp', width: 2000, height: 1333,
    alt: copy('Police s výběrovou kávou a keramikou v Kafe Grohova.', 'Shelves of specialty coffee and ceramics at Kafe Grohova.'),
    eyebrow: copy('03 / To nejlepší ze zrnka', '03 / The best of the bean'),
    title: [copy('Káva', 'Coffee'), copy('i na doma.', 'for home.')],
    label: copy('Výběrová káva', 'Specialty coffee'),
  },
  {
    key: 'merch', src: '/ceramic.webp', width: 940, height: 940,
    alt: copy('Barevná keramika vystavená v kavárně.', 'Colourful ceramics on display at the café.'),
    eyebrow: copy('04 / Malé věci, velká radost', '04 / Little things, lots of joy'),
    title: [copy('Kousek', 'A little'), copy('Grohovy.', 'Grohova.')],
    label: copy('Merch & další radosti', 'Merch & more'),
  },
];
const image = new URL('/img33.webp', Astro.site ?? Astro.url.origin).href;
---
<BaseLayout fullBleed image={image}>
  <HomeNavigation slot="navigation" lang={lang} />
  <section class="hero" id="home-top" aria-labelledby="home-title">
    <img class="hero-photo" src="/img33.webp" alt={copy('Pohled z Grohovy ulice do kavárny, kde u okna sedí hosté.', 'Looking through the café window from Grohova street, with guests seated inside.')} width="2000" height="1333" fetchpriority="high" />
    <div class="header-line" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-kicker">
        <p class="eyebrow" lang="en">Specialty coffee.<br />Brno state of mind.</p>
        <span class="hero-mark" aria-hidden="true">{copy('VAŠE|MÍSTO|NA KAFE', 'YOUR|PLACE|FOR COFFEE').split('|').map(line => <span>{line}</span>)}</span>
      </div>
      <h1 class="display" id="home-title" lang="cs"><span>Stav se.</span><span>Grohova 3.</span></h1>
      <div class="hero-bottom"><div class="hero-location"><span>Grohova 3, Brno</span><span lang="en">Size doesn't matter. Taste does.</span></div><a href="#about">{copy('Vítejte u nás', 'Welcome in')} <span class="arrow" aria-hidden="true">↓</span></a></div>
    </div>
  </section>
  <section class="intro" id="about" aria-labelledby="intro-title">
    <div class="section-meta eyebrow"><span>01 / Kafe Grohova</span><span class="dash" aria-hidden="true"></span><span>{copy('Káva nás spojuje.', 'Coffee brings us together.')}</span></div>
    <div class="intro-grid">
      <h2 class="display" id="intro-title"><span>{copy('Malý bar.', 'Small bar.')}</span><span>{copy('Velká láska', 'Big love')}</span><span>{copy('ke kávě', 'for coffee')}<em>.</em></span></h2>
      <div class="intro-copy">
        <p>{copy('Jsme malé espresso barové místo na Grohově v Brně. Věříme na dobrou kávu, poctivou přípravu a chvíle, které nemusíte uspěchat.', 'We are a small espresso bar on Grohova in Brno. We believe in good coffee, thoughtful preparation and moments you do not have to rush.')}</p>
        <p>{copy('Stavte se na svoje oblíbené espresso, objevte novou chuť nebo se s námi naučte něco za barem. Místo se tu najde.', 'Drop in for your favourite espresso, discover a new flavour or learn something behind the bar with us. There is a place for you here.')}</p>
        <a class="text-link" href="#visit">{copy('Potkáme se na Grohově', 'Meet us on Grohova')}<span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="intro-tail eyebrow"><span>{copy('02 / Kousek Grohovy pro vás', '02 / A little Grohova for you')}</span><span>{copy('U nás. U vás. Každý den.', 'Here. At home. Every day.')}</span></div>
  </section>
  <section class="masonry" id="shop" aria-label={copy('Kurzy, vybavení, káva a merch', 'Courses, equipment, coffee and merch')}>
    <a class="tile courses" id="courses" href={localePath(lang, '/courses')}>
      <img src="/specialcoffee.webp" alt={copy('Detail rukou při nalévání latte art.', 'Hands pouring milk into a cup to make latte art.')} width="940" height="940" loading="lazy" />
      <div class="tile-top eyebrow"><span>{copy('01 / Naučte se to s námi', '01 / Learn with us')}</span><span>Brno, Grohova</span></div>
      <div class="tile-body"><h2 class="tile-title display"><span>{copy('Za bar', 'Your turn')}</span><span>{copy('můžete i vy.', 'behind the bar.')}</span></h2><div class="tile-bottom"><span>{t('nav.courses')}</span><span class="arrow" aria-hidden="true">↗</span></div></div>
    </a>
    {categories.map(category => (
      <Category class:list={['tile', category.key]} data-home-category={category.key} href={storeHref}>
        <img src={category.src} alt={category.alt} width={category.width} height={category.height} loading="lazy" />
        <div class="tile-top eyebrow"><span>{category.eyebrow}</span></div>
        <div class="tile-body"><h2 class="tile-title display">{category.title.map(line => <span>{line}</span>)}</h2><div class="tile-bottom"><span>{category.label}</span>{MERCH_ENABLED ? <span class="arrow" aria-hidden="true">↗</span> : <span class="coming-soon">{copy('Připravujeme', 'Coming soon')}</span>}</div></div>
      </Category>
    ))}
    <figure class="tile ritual"><img src="/images/OLD03342.webp" alt={copy('Šálek kávy a sklenice vody na baru vedle zelené rostliny.', 'A cup of coffee and a glass of water beside a green plant on the counter.')} width="2000" height="3000" loading="lazy" /></figure>
    <div class="red-note"><span class="asterisk" aria-hidden="true">✳</span><strong>{copy('O trochu|lepší|každý|den.', 'A little|better.|Every|day.').split('|').map(line => <span>{line}</span>)}</strong><span class="eyebrow">{copy('Od prvního doušku.', 'From the first sip.')}</span></div>
    <figure class:list={['tile', 'barista', { 'barista-wide': !GIFT_CARDS_ENABLED }]}><img src="/images/OLD03400.webp" alt={copy('Barista připravuje kávu za barem Kafe Grohova.', 'A barista preparing coffee behind the counter at Kafe Grohova.')} width="2000" height="1333" loading="lazy" /></figure>
    {GIFT_CARDS_ENABLED && <a class="tile gift-tile" href={localePath(lang, '/gift-cards')}><span class="eyebrow">{copy('Pro někoho vašeho', 'For someone you love')}</span><strong class="display">{copy('Darujte|dobré|chvíle.', 'Give|good|times.').split('|').map(line => <span>{line}</span>)}</strong><span class="gift-bottom eyebrow">{t('nav.giftCards')}<span class="arrow" aria-hidden="true">↗</span></span></a>}
  </section>
  <HomeFooter slot="footer" lang={lang} />
</BaseLayout>
