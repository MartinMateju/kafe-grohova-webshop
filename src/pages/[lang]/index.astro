---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitFeature from '../../components/SplitFeature.astro';
import CourseCard from '../../components/CourseCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { allLangs, localePath, useTranslations, type Lang } from '../../i18n/utils';
import { getCourses, getMerch, bookableVariants } from '../../lib/shopify';
import { MERCH_ENABLED } from '../../lib/shopify/config';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const [merch, courses] = await Promise.all([getMerch(lang), getCourses(lang)]);
// Courses with open dates come first; retain catalog order within each group.
const featuredCourses = [...courses].sort((a, b) =>
  Number(bookableVariants(b).length > 0) - Number(bookableVariants(a).length > 0));

const intro = lang === 'cs'
  ? 'Kafe Grohova je malé espresso barové místo v Brně. Výběrová káva, pečlivá příprava a lidé, které káva baví. Za barem ochutnáváme, zkoušíme a každý den se učíme něco nového. Na kurzech se o to všechno podělíme s vámi.'
  : 'Kafe Grohova is a small espresso bar in Brno. Specialty coffee, thoughtful preparation and people who love what they do. Behind the bar we taste, experiment and learn something new every day. In our courses, we share it all with you.';
const specialtyCopy = lang === 'cs'
  ? 'Na kávu se můžete zastavit i bez kurzu. Na baru najdete espresso, filtrovanou kávu a něco, co zrovna zkoušíme. Těšíme se na vás na Grohové.'
  : 'You can stop by for a coffee without taking a course. There is espresso, filter coffee and something we are currently trying. Find us on Grohova.';
---

<BaseLayout title={t('home.coursesHeadline')} description={t('home.coursesIntro')}>
  <div class="flex flex-col gap-12 pt-6 lg:gap-20 lg:pt-10">
    <section class="grid overflow-hidden bg-brick text-cream md:grid-cols-2" aria-labelledby="home-title">
      <div class="flex flex-col items-start justify-center gap-6 p-6 md:p-8 lg:p-12">
        <p class="text-[12px] tracking-[0.16em] uppercase">KAFE GROHOVA · BRNO</p>
        <h1 id="home-title" class="text-[38px] leading-[1.05] sm:text-[48px] lg:text-[68px]">
          {t('home.coursesHeadline')}
        </h1>
        <p class="max-w-lg text-[16px] leading-relaxed lg:text-[20px]">{t('home.coursesIntro')}</p>
        <a href="#courses" class="inline-flex items-center gap-5 border border-cream bg-cream px-6 py-3 text-[13px] tracking-widest text-ink transition-colors hover:bg-transparent hover:text-cream">
          {t('home.chooseCourse')} <span aria-hidden="true">↓</span>
        </a>
        <p class="text-[13px] text-cream/80">{t('home.smallGroups')}</p>
      </div>
      <img src="/specialcoffee.webp" alt={lang === 'cs' ? 'Příprava latte art v Kafe Grohova' : 'Making latte art at Kafe Grohova'} fetchpriority="high" class="h-[20rem] w-full object-cover md:h-full md:min-h-[32rem]" />
    </section>

    <section id="courses" class="flex scroll-mt-6 flex-col gap-6" aria-labelledby="courses-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-2">
          <p class="label text-brick">{t('home.smallGroups')}</p>
          <h2 id="courses-title" class="text-[30px] leading-tight md:text-[44px]">{t('courses.title')}</h2>
        </div>
        <a href={localePath(lang, '/courses')} class="border-b border-ink pb-1 text-[13px] tracking-widest hover:text-brick">
          {t('courses.upcoming')} →
        </a>
      </div>
      {featuredCourses.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {featuredCourses.map((course) => <CourseCard product={course} lang={lang} layout="tile" />)}
        </div>
      ) : (
        <p class="border border-ink/20 p-6">{t('courses.noDates')}</p>
      )}
    </section>

    <section class="grid items-center gap-8 md:grid-cols-2 lg:gap-12" aria-labelledby="cafe-title">
      <img src="/expressobar.webp" alt="" loading="lazy" class="h-[22rem] w-full object-cover md:h-[30rem]" />
      <div class="flex flex-col items-start gap-5">
        <h2 id="cafe-title" class="text-[30px] md:text-[42px]">{t('home.espressobar')}</h2>
        <p class="text-[17px] leading-relaxed lg:text-[21px]">{intro}</p>
        <a href={localePath(lang, '/contact')} class="border-b border-ink pb-1 text-[13px] tracking-widest hover:text-brick">{t('contact.findUs')} →</a>
      </div>
    </section>

    <SplitFeature bg="bg-stone" img="/specialcoffee.webp" title={t('home.specialty')} content={specialtyCopy} />

    {MERCH_ENABLED && merch.length > 0 && (
      <section class="flex flex-col gap-5">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-[28px]">{t('store.title')}</h2>
          <a href={localePath(lang, '/store')} class="text-[13px] tracking-widest hover:text-brick">{t('home.shopCta')} →</a>
        </div>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {merch.slice(0, 4).map((product) => <ProductCard product={product} lang={lang} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
