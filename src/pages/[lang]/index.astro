---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { allLangs, localePath, useTranslations, type Lang } from '../../i18n/utils';
import { getCourses, getMerch, formatMoney, imageUrl } from '../../lib/shopify';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const cs = lang === 'cs';

const [merch, courses] = await Promise.all([getMerch(lang), getCourses(lang)]);
const featured = merch.slice(0, 8);
const leadCourse = courses[0];
const courseHero = imageUrl(leadCourse?.featuredImage?.url, 1400) || '/images/OLD03346.webp';

// ── Copy (kept inline, bilingual, matching the project's existing pattern) ──
const heroKicker = cs ? 'VÝBĚROVÁ KÁVA & VYBAVENÍ' : 'SPECIALTY COFFEE & GEAR';
const heroTitleA = cs ? 'Espresso bar,' : 'For your';
const heroTitleB = cs ? 'apperently.' : 'best cup.';
const heroSub = cs
  ? 'Výběrová káva, baristické vybavení a kurzy — z Kafe Grohova v Brně, až k vám domů.'
  : 'Specialty coffee, barista gear and courses — from Kafe Grohova in Brno, straight to your door.';

const featuredTitle = cs ? 'VÝBĚR Z OBCHODU' : 'FROM THE STORE';

const coursesHeadline = cs ? 'Zvládněte kávu\njako barista.' : 'Make coffee\nlike a barista.';
const coursesCopy = cs
  ? 'Malé skupiny, profesionální vybavení a lektoři, kteří stojí za barem každý den. Od základů espressa po latte art a filtrovanou kávu doma.'
  : 'Small groups, professional equipment and instructors who stand behind the bar every day. From espresso fundamentals to latte art and filter coffee at home.';

// ── Button styles ──
const btnOnImage =
  'inline-flex items-center gap-2 bg-brick px-8 py-4 text-[12px] uppercase tracking-[0.16em] text-cream transition-colors hover:bg-cream hover:text-ink';
const btnOnImageGhost =
  'inline-flex items-center gap-2 border border-cream/70 px-8 py-4 text-[12px] uppercase tracking-[0.16em] text-cream transition-colors hover:bg-cream hover:text-ink';
const btnOutline =
  'inline-flex w-fit items-center gap-2 border border-ink px-8 py-4 text-[12px] uppercase tracking-[0.16em] text-ink transition-colors hover:bg-ink hover:text-cream';
---

<BaseLayout>
  <div class="flex flex-col gap-20 lg:gap-32">
    {/* ── Hero ───────────────────────────────────────────────── */}
    <section class="relative -mx-3 mt-3 overflow-hidden">
      <img
        src="/img33.webp"
        alt={cs
          ? 'Kafe Grohova — espresso bar a obchod v Brně'
          : 'Kafe Grohova — espresso bar and store in Brno'}
        fetchpriority="high"
        class="h-[74vh] min-h-[30rem] w-full object-cover object-[62%_28%]"
      />
      {/* darken from the bottom-left so the copy always reads clearly */}
      <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/40 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-ink/10 to-transparent"></div>

      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10 lg:p-16">
        <div class="flex max-w-xl flex-col gap-5 text-cream">
          <span class="text-[12px] uppercase tracking-[0.22em] text-cream/75">
            {heroKicker}
          </span>
          <h1 class="text-[clamp(2.5rem,6.5vw,5rem)] leading-[0.95] tracking-tight [text-shadow:0_2px_24px_rgba(0,0,0,0.35)]">
            {heroTitleA} <span class="text-brick">{heroTitleB}</span>
          </h1>
          <p class="max-w-md text-[15px] leading-relaxed text-cream/85 lg:text-[18px]">
            {heroSub}
          </p>
          <div class="mt-2 flex flex-wrap gap-3">
            <a href={localePath(lang, '/store')} class={btnOnImage}>
              {t('home.shopCta')} →
            </a>
            <a href={localePath(lang, '/courses')} class={btnOnImageGhost}>
              {t('nav.courses')}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── Featured products ──────────────────────────────────── */}
    <section class="flex flex-col gap-8 lg:gap-12">
      <div class="flex items-end justify-between gap-4 border-b border-ink/15 pb-4">
        <h2 class="text-[clamp(1.75rem,5vw,3.25rem)] leading-none tracking-tight">
          {featuredTitle}
        </h2>
        <a
          href={localePath(lang, '/store')}
          class="group relative shrink-0 whitespace-nowrap pb-1 text-[12px] uppercase tracking-[0.16em] text-ink transition-colors hover:text-brick"
        >
          {t('home.shopCta')} →
        </a>
      </div>

      <div class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {
          featured.map((product) => (
            <ProductCard product={product} lang={lang} soldOutLabel={t('product.soldOut')} />
          ))
        }
      </div>
    </section>

    {/* ── Barista courses ────────────────────────────────────── */}
    <section class="flex flex-col gap-10 lg:gap-14">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="overflow-hidden">
          <img
            src={courseHero}
            alt=""
            loading="lazy"
            class="h-[62vw] w-full object-cover md:h-[26rem] lg:h-[34rem]"
          />
        </div>

        <div class="flex flex-col gap-6 lg:pr-6">
          <span class="text-[12px] uppercase tracking-[0.22em] text-brick">
            {t('home.coursesTitle')}
          </span>
          <h2 class="whitespace-pre-line text-[clamp(2rem,5.5vw,3.75rem)] leading-[0.98] tracking-tight">
            {coursesHeadline}
          </h2>
          <p class="max-w-md text-[15px] leading-relaxed text-ink/70 lg:text-[18px]">
            {coursesCopy}
          </p>
          <a href={localePath(lang, '/courses')} class={btnOutline}>
            {t('home.coursesCta')}
          </a>
        </div>
      </div>

      {
        courses.length > 0 && (
          <ul class="grid gap-3 md:grid-cols-3">
            {courses.slice(0, 3).map((course) => (
              <li>
                <a
                  href={localePath(lang, `/courses/${course.handle}`)}
                  class="flex h-full flex-col justify-between gap-8 border border-ink/20 p-6 transition-colors hover:border-brick hover:text-brick"
                >
                  <span class="text-[20px] leading-tight lg:text-[24px]">{course.title}</span>
                  <span class="text-[13px] uppercase tracking-[0.12em] text-ink/50">
                    {t('courses.from')} {formatMoney(course.priceRange.minVariantPrice, lang)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>
