---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizedPaths } from '../../../i18n/paths';
import { localePath, useTranslations, type Lang } from '../../../i18n/utils';
import { getArticles, formatDate, imageUrl } from '../../../lib/shopify';

export async function getStaticPaths() {
  return localizedPaths(getArticles, 'blog');
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { item: article, alternatePaths } = Astro.props;
const hero = imageUrl(article.image?.url, 1600);
const others = (await getArticles(lang)).filter((a) => a.handle !== article.handle).slice(0, 4);
---

<BaseLayout alternatePaths={alternatePaths} title={article.title} description={article.excerpt.slice(0, 160)} image={hero}>
  <article class="brand-page article-page">
    <a href={localePath(lang, '/blog')} class="article-back"><span aria-hidden="true">←</span> {t('blog.back')}</a>
    <header class="article-heading">
      <p class="section-kicker">KAFE GROHOVA / {t('blog.title')}</p>
      <h1 class="page-heading">{article.title}</h1>
      <p class="article-meta"><time datetime={article.publishedAt ?? undefined}>{formatDate(article.publishedAt, lang)}</time>{article.authorName && <span> / {article.authorName}</span>}</p>
      {article.excerpt && <p class="editorial-intro">{article.excerpt}</p>}
    </header>

    {hero && <figure class="article-hero"><img src={hero} alt={article.image?.altText ?? article.title} width="1600" height="1000" /></figure>}

    <div class="article-reading">
      <aside class="reading-label" aria-hidden="true"><span class="section-kicker">KAFE<br />GROHOVA</span></aside>
      <div class="rte article-body" set:html={article.contentHtml} />
    </div>

    {others.length > 0 && (
      <section class="related-stories" aria-labelledby="related-heading">
        <div class="related-rule"><h2 class="section-kicker" id="related-heading">{lang === 'cs' ? 'Ještě chvíli čtení' : 'A little more reading'}</h2><a href={localePath(lang, '/blog')}>{t('blog.title')} <span aria-hidden="true">↗</span></a></div>
        <div class="related-grid">
          {others.map((other) => (
            <article>
              <a href={localePath(lang, `/blog/${other.handle}`)}>
                <div class="related-image">{other.image && <img src={imageUrl(other.image.url, 800)} alt="" loading="lazy" width="800" height="640" />}</div>
                <h3>{other.title}</h3>
              </a>
              <time datetime={other.publishedAt ?? undefined}>{formatDate(other.publishedAt, lang)}</time>
            </article>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article-page { padding-block: clamp(2rem, 5vw, 5rem) clamp(3rem, 6vw, 6rem); }
  .article-back { display: inline-flex; gap: 1rem; align-items: center; font-size: .9rem; padding-block: .5rem; }
  .article-back:hover, .related-rule a:hover, .related-grid a:hover { color: var(--color-brick); }
  .article-heading { max-width: 68rem; margin-block: clamp(2rem, 5vw, 5rem) 3rem; }
  .article-heading h1 { margin-block: 1.5rem; font-size: clamp(2.65rem, 5.5vw, 5.8rem); overflow-wrap: anywhere; }
  .article-meta { font-family: var(--font-display); font-size: .85rem; line-height: 1.6; margin-bottom: 2rem; }
  .article-heading .editorial-intro { max-width: 45rem; }
  .article-hero { margin: 0 0 clamp(3rem, 6vw, 6rem); }
  .article-hero img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .article-reading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 2rem; max-width: 72rem; }
  .reading-label { border-top: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); padding-top: 1rem; }
  .article-body { max-width: 67ch; min-width: 0; font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.85; overflow-wrap: anywhere; }
  .article-body :global(h2), .article-body :global(h3) { font-family: var(--font-sans); font-weight: 700; letter-spacing: -.035em; line-height: 1.2; }
  .article-body :global(img) { height: auto; max-width: 100%; }
  .article-body :global(blockquote) { border-left: 2px solid var(--color-brick); padding-left: 1.5rem; margin-block: 2rem; font-size: 1.2em; }
  .related-stories { margin-top: clamp(4rem, 8vw, 8rem); }
  .related-rule { display: flex; justify-content: space-between; gap: 2rem; border-top: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); padding-top: 1rem; margin-bottom: 2rem; }
  .related-rule > a { font-family: var(--font-display); font-size: .85rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: clamp(1.5rem, 3vw, 3rem); }
  .related-image { background: color-mix(in srgb, var(--color-ink) 7%, transparent); aspect-ratio: 5 / 4; overflow: hidden; }
  .related-image img { width: 100%; height: 100%; object-fit: cover; }
  .related-grid h3 { margin-block: 1rem .75rem; font-family: var(--font-sans); font-weight: 700; font-size: 1.4rem; letter-spacing: -.03em; line-height: 1.2; }
  .related-grid time { font-family: var(--font-display); font-size: .8rem; }
  @media (max-width: 760px) { .article-reading { grid-template-columns: 1fr; } .reading-label { display: none; } .article-hero img { aspect-ratio: 4 / 3; } .article-heading h1 { font-size: clamp(2.5rem, 10vw, 4.5rem); } }
</style>
