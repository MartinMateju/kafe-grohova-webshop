---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseCard from '../../../components/CourseCard.astro';
import { allLangs, localePath, type Lang } from '../../../i18n/utils';
import { getCourses, getGiftCards, GIFT_CARDS_ENABLED, formatDateTime, formatMoney, isMockMode } from '../../../lib/shopify';
import { firstBookableCourseVariant, isLatteArtCourse, resolveLatteArtGiftCard, isManualLatteArtGiftCard } from '../../../lib/coursePresentation';
export function getStaticPaths() { return allLangs.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const cs = lang === 'cs';
const courses = await getCourses(lang);
const latte = courses.find(isLatteArtCourse);
const next = latte ? firstBookableCourseVariant(latte) : null;
const gift = resolveLatteArtGiftCard((await getGiftCards(lang)).filter(isManualLatteArtGiftCard));
const cupping = courses.find(course => course.handle === 'cupping' || course.tags.includes('cupping'));
---
<BaseLayout title={cs ? 'Baristické kurzy' : 'Barista courses'} description={cs ? 'Latte art pro začátečníky v Kafe Grohova. Malá skupina a čas na vlastní první srdce.' : 'Beginner latte art at Kafe Grohova. A small group and time for your first heart.'}>
  <div class="brand-page courses-page">
    <header class="course-page-header"><p class="section-kicker">{cs ? 'Kafe Grohova / Kurzy' : 'Kafe Grohova / Courses'}</p><h1 class="page-heading">{cs ? 'Teď jste' : 'Your turn'}<br />{cs ? 'na řadě vy.' : 'behind the bar.'}</h1><p class="editorial-intro">{cs ? 'Dobrá káva začíná zvědavostí. Pojďte si ji připravit s námi — od prvních otázek až po poslední doušek.' : 'Good coffee starts with curiosity. Make it with us, from your first question to your last sip.'}</p></header>
    {next && latte && <a data-upcoming-date href={localePath(lang, '/courses/' + latte.handle)} class="next-session"><span class="section-kicker">{cs ? 'Nejbližší termín' : 'Next session'}{isMockMode && <small> / {cs ? 'ukázka nákupu' : 'demo checkout'}</small>}</span><span>{formatDateTime(next.startsAt!, lang)}</span><span>{formatMoney(next.price, lang)}</span><span aria-hidden="true">↗</span></a>}
    {latte ? <CourseCard product={latte} lang={lang} /> : <section class="course-empty"><h2>{cs ? 'Latte art pro začátečníky' : 'Latte art for beginners'}</h2><p>{cs ? '25. listopadu 2026, 17:00–19:30. Cena 2 100 Kč za osobu. Online rezervaci připravujeme — s přihlášením vám poradíme.' : '25 November 2026, 17:00–19:30. CZK 2,100 per person. Online booking is being prepared; get in touch to enquire.'}</p><a href={localePath(lang, '/contact')}>{cs ? 'Napište nám' : 'Get in touch'} ↗</a></section>}
    <section class="coming-section"><div class="coming-heading"><p class="section-kicker">{cs ? 'A co dál?' : 'What is next?'}</p><h2>{cs ? 'Ještě trochu' : 'A little more'}<br />{cs ? 'zvědavosti.' : 'curiosity.'}</h2></div><div class="coming-grid">
      <article data-course-card="senzorika" data-coming-soon><img src="/photos/espresso-pour.webp" alt={cs ? 'Detail přípravy espressa.' : 'Espresso pouring into a cup.'} width="960" height="1440" loading="lazy" /><p class="section-kicker">{cs ? 'Připravujeme' : 'Coming soon'}</p><h3>{cs ? 'Senzorika.' : 'Sensory skills.'}</h3><p>{cs ? 'Vůně, sladkost, kyselost. Chystáme prostor, kde je společně objevíme.' : 'Aroma, sweetness, acidity. A space to discover them together is on its way.'}</p></article>
      <article data-course-card={cupping?.handle ?? 'cupping'} data-coming-soon><img src="/photos/coffee-bags.webp" alt={cs ? 'Výběrová káva v Kafe Grohova.' : 'Specialty coffee at Kafe Grohova.'} width="960" height="1440" loading="lazy" /><p class="section-kicker">{cs ? 'Připravujeme' : 'Coming soon'}</p><h3>Cupping.</h3><p>{cs ? 'Ochutnávání vedle sebe, nové rozdíly v každém šálku. Termíny zveřejníme později.' : 'Taste coffees side by side and discover the differences in every cup. Dates will follow.'}</p>{cupping && <a href={localePath(lang, '/courses/' + cupping.handle)}>{cs ? 'O připravovaném kurzu' : 'About the upcoming course'} ↗</a>}</article>
    </div></section>
    {GIFT_CARDS_ENABLED && <section class="course-gift"><div><p class="section-kicker">{cs ? 'Radost pro někoho vašeho' : 'For someone you love'}</p><h2>{cs ? 'První srdce' : 'Their first heart'}<br />{cs ? 'jako dárek.' : 'as a gift.'}</h2></div><div><p>{cs ? 'Darujte chuť vyzkoušet něco nového. Poukaz na Latte art pro začátečníky stojí 2 100 Kč na osobu. Termín si obdarovaný vybere později.' : 'Give them a reason to try something new. A beginner latte art voucher is CZK 2,100 per person. They choose a date later.'}</p><a href={localePath(lang, '/gift-cards/' + (gift?.handle ?? 'poukaz-latte-art'))}>{cs ? 'Prohlédnout poukaz' : 'Explore the voucher'} ↗</a></div></section>}
  </div>
</BaseLayout>
<style>
.course-page-header{max-width:1020px;margin-bottom:48px}.course-page-header .editorial-intro{max-width:550px;margin:30px 0 0 auto}.next-session{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 26px;background:#29211d;color:#f3e8d9;margin-bottom:55px;font-size:18px}.next-session .section-kicker{color:inherit}.next-session small{font-size:inherit}.next-session>span:last-child{font:30px var(--font-sans)}.coming-section{margin-top:110px}.coming-heading{display:flex;justify-content:space-between;align-items:start;margin-bottom:35px}.coming-heading h2{font:600 clamp(36px,5vw,66px)/1.02 var(--font-sans);letter-spacing:-.055em}.coming-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px}.coming-grid img{height:340px;width:100%;object-fit:cover}.coming-grid .section-kicker{margin-top:25px}.coming-grid h3{font:600 34px/1.1 var(--font-sans);letter-spacing:-.04em;margin:12px 0}.coming-grid article>p:not(.section-kicker){max-width:410px;font:16px/1.6 var(--font-sans)}.coming-grid a{display:inline-block;margin-top:20px;border-bottom:1px solid currentColor;padding-bottom:6px;font-size:13px}.course-gift{display:grid;grid-template-columns:1.2fr 1fr;gap:65px;border-top:1px solid #29211d40;margin-top:100px;padding:45px 0 20px}.course-gift h2{font:600 clamp(38px,5vw,70px)/1.03 var(--font-sans);letter-spacing:-.055em;margin:20px 0}.course-gift>div:last-child{align-self:center}.course-gift p:not(.section-kicker){font:18px/1.6 var(--font-sans);max-width:420px}.course-gift a,.course-empty a{display:inline-block;border-bottom:1px solid currentColor;padding:15px 0 7px}.course-empty{padding:60px 0;border-block:1px solid #29211d40}.course-empty h2{font-size:32px;margin-bottom:20px}
@media(max-width:700px){.next-session{display:grid;grid-template-columns:1fr auto;gap:14px;padding:20px}.next-session>.section-kicker{grid-column:1/-1}.next-session>span:nth-child(2){font-size:16px}.next-session>span:last-child{display:none}.coming-section{margin-top:60px}.coming-heading{display:block}.coming-heading h2{margin-top:20px}.coming-grid{grid-template-columns:1fr;gap:45px}.coming-grid img{height:360px}.course-gift{grid-template-columns:1fr;gap:15px;margin-top:60px}}
</style>
