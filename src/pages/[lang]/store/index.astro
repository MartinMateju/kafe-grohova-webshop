---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { allLangs, useTranslations, type Lang } from '../../../i18n/utils';
import { getMerch } from '../../../lib/shopify';
import { MERCH_ENABLED } from '../../../lib/shopify/config';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
if (!MERCH_ENABLED) return Astro.redirect(`/${lang}/courses/`, 302);
const t = useTranslations(lang);
const products = await getMerch(lang);
const copy = lang === 'cs' ? {
  title: 'Kousek Grohovy.', second: 'K vám domů.',
  intro: 'Káva, keramika a další kousky z našeho obchodu. Prohlédněte si aktuální nabídku.',
  label: 'Obchod', photo: 'Keramické hrnky v Kafe Grohova',
} : {
  title: 'A little Grohova.', second: 'For your home.',
  intro: 'Coffee, ceramics and other finds from our store. Take a look at the current selection.',
  label: 'Store', photo: 'Ceramic cups at Kafe Grohova',
};
---

<BaseLayout title={t('store.title')} description={copy.intro}>
  <div class="brand-page store-page">
    <header class="store-heading">
      <div>
        <p class="section-kicker">KAFE GROHOVA / {copy.label}</p>
        <h1 class="page-heading">{copy.title}<br /><span>{copy.second}</span></h1>
        <p class="editorial-intro">{copy.intro}</p>
      </div>
      <img src="/photos/ceramics-hands.webp" alt={copy.photo} width="960" height="1439" />
    </header>

    <section class="store-catalog" aria-labelledby="store-products">
      <div class="catalog-heading"><h2 class="section-kicker" id="store-products">{t('store.all')}</h2><span aria-hidden="true">({String(products.length).padStart(2, '0')})</span></div>
      {products.length === 0 ? <p class="store-empty">{t('store.empty')}</p> : (
        <div class="product-grid">
          {products.map((product) => <ProductCard product={product} lang={lang} heightClass="aspect-[4/5]" soldOutLabel={t('product.soldOut')} />)}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .store-page { padding-block: clamp(2.5rem, 6vw, 6rem); }
  .store-heading { display: grid; grid-template-columns: 1.35fr .65fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .store-heading > div { min-width: 0; }
  .store-heading h1 { font-size: clamp(2.75rem, 5.9vw, 6rem); margin-block: 1.5rem 2rem; }
  .store-heading h1 span { color: var(--color-brick); }
  .store-heading .editorial-intro { max-width: 35rem; }
  .store-heading > img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .store-catalog { margin-top: clamp(3.5rem, 7vw, 7rem); }
  .catalog-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; border-top: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); padding-top: 1rem; margin-bottom: 2rem; }
  .catalog-heading > span { font-family: var(--font-display); font-size: .8rem; }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 3vw, 3rem); }
  .store-empty { padding-block: 3rem; font-size: 1.1rem; }
  @media (max-width: 900px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .store-heading { grid-template-columns: 1fr; } .store-heading h1 { font-size: clamp(2.6rem, 10.5vw, 4.5rem); } .store-heading > img { aspect-ratio: 4 / 3; } .product-grid { grid-template-columns: 1fr; } }
</style>
