---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localizedPaths } from '../../../i18n/paths';
import AddToCart from '../../../components/AddToCart.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { localePath, useTranslations, type Lang } from '../../../i18n/utils';
import { getMerch, formatMoney, imageUrl, isCourse } from '../../../lib/shopify';

export async function getStaticPaths() {
  return localizedPaths(getMerch, 'store');
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { item: product, alternatePaths } = Astro.props;
const related = (await getMerch(lang)).filter((p) => p.handle !== product.handle && !isCourse(p)).slice(0, 4);
const gallery = product.images.length ? product.images : product.featuredImage ? [product.featuredImage] : [];
const price = formatMoney(product.priceRange.minVariantPrice, lang);
---

<BaseLayout alternatePaths={alternatePaths} title={product.title} description={product.description.slice(0, 160)} image={imageUrl(product.featuredImage?.url, 1200)}>
  <div class="brand-page product-page">
    <a href={localePath(lang, '/store')} class="product-back"><span aria-hidden="true">←</span> {t('product.back')}</a>
    <div class="product-detail">
      <div class="product-gallery">
        {gallery.length ? gallery.map((image, index) => (
          <img src={imageUrl(image.url, 1200)} alt={image.altText ?? product.title} loading={index === 0 ? 'eager' : 'lazy'} width={image.width ?? 1200} height={image.height ?? 1500} />
        )) : <div class="gallery-empty" />}
      </div>
      <div class="product-purchase">
        <header>
          <p class="section-kicker">KAFE GROHOVA / {lang === 'cs' ? 'OBCHOD' : 'STORE'}</p>
          <h1 class="page-heading">{product.title}</h1>
          <p data-product-price class="product-price" aria-live="polite">{price}</p>
        </header>
        <div class="purchase-controls"><AddToCart product={product} lang={lang} /></div>
        {product.descriptionHtml && (
          <section class="product-description" aria-labelledby="product-description-title">
            <h2 class="section-kicker" id="product-description-title">{t('product.description')}</h2>
            <div class="rte" set:html={product.descriptionHtml} />
          </section>
        )}
      </div>
    </div>

    {related.length > 0 && (
      <section class="related-products" aria-labelledby="related-products-title">
        <h2 class="section-kicker" id="related-products-title">{t('product.related')}</h2>
        <div class="related-grid">
          {related.map((item) => <ProductCard product={item} lang={lang} heightClass="aspect-[4/5]" soldOutLabel={t('product.soldOut')} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .product-page { padding-block: clamp(2rem, 5vw, 5rem) clamp(3rem, 6vw, 6rem); }
  .product-back { display: inline-flex; align-items: center; gap: 1rem; padding-block: .5rem; margin-bottom: 2rem; font-size: .9rem; }
  .product-back:hover { color: var(--color-brick); }
  .product-detail { display: grid; grid-template-columns: 1.1fr .9fr; align-items: start; gap: clamp(2rem, 6vw, 7rem); }
  .product-gallery { display: grid; gap: 1.5rem; min-width: 0; }
  .product-gallery img { width: 100%; height: auto; object-fit: cover; }
  .gallery-empty { aspect-ratio: 4 / 5; background: color-mix(in srgb, var(--color-ink) 7%, transparent); }
  .product-purchase { position: sticky; top: 2rem; min-width: 0; }
  .product-purchase h1 { font-size: clamp(2.3rem, 3.8vw, 4.2rem); margin-block: 1.25rem 1.5rem; overflow-wrap: anywhere; }
  .product-price { font-family: var(--font-display); font-size: 1.7rem; margin-bottom: 2rem; }
  .purchase-controls { padding-block: 2rem; border-block: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); }
  .product-description { margin-top: 2rem; }
  .product-description .section-kicker { margin-bottom: 1rem; }
  .product-description .rte { font-size: 1rem; line-height: 1.8; overflow-wrap: anywhere; }
  .related-products { border-top: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); margin-top: clamp(3.5rem, 7vw, 7rem); padding-top: 1rem; }
  .related-products > h2 { margin-bottom: 2rem; }
  .related-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 3rem); }
  @media (max-width: 900px) { .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .product-detail { grid-template-columns: 1fr; } .product-purchase { position: static; } }
  @media (max-width: 420px) { .related-grid { grid-template-columns: 1fr; } }
</style>
