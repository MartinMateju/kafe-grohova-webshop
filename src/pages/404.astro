---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" alternatePaths={{ cs: '/cs/', en: '/en/' }}>
  <div class="brand-page flex min-h-[65vh] flex-col items-center justify-center gap-6 text-center">
    <p class="section-kicker">Kafe Grohova / Lost in Brno</p>
    <h1 class="page-heading">404.</h1>
    <p class="text-[18px] text-ink/60">
      Tahle stránka neexistuje. / This page does not exist.
    </p>
    <div class="flex gap-4">
      <a href="/cs/" class="border border-ink px-6 py-3 text-[13px] tracking-widest hover:bg-ink hover:text-cream">
        ÚVOD
      </a>
      <a href="/en/" class="border border-ink px-6 py-3 text-[13px] tracking-widest hover:bg-ink hover:text-cream">
        HOME
      </a>
    </div>
  </div>
</BaseLayout>
