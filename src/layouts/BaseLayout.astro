---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { getLangFromUrl, useTranslations, switchLocalePath } from '../i18n/utils';
import { isMockMode } from '../lib/shopify/config';

interface Props {
  title?: string;
  description?: string;
  /** Optional OG image URL */
  image?: string;
}

const { title, description, image } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = 'Kafe Grohova';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const pageDescription =
  description ??
  (lang === 'cs'
    ? 'Espresso bar a obchod na Grohové v Brně. Výběrová káva, ruční keramika a baristické kurzy.'
    : 'Espresso bar and store on Grohova in Brno. Specialty coffee, handmade ceramics and barista courses.');

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const csHref = new URL(switchLocalePath(Astro.url, 'cs'), canonical);
const enHref = new URL(switchLocalePath(Astro.url, 'en'), canonical);
---

<!doctype html>
<html lang={lang === 'cs' ? 'cs' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="cs" href={csHref.href} />
    <link rel="alternate" hreflang="en" href={enHref.href} />
    <link rel="alternate" hreflang="x-default" href={csHref.href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href="/fonts/dince-regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FDEDC3" />
  </head>

  <body class="antialiased p-3 bg-cream text-ink min-h-screen w-full">
    <div class="container">
      <Navbar />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <CartDrawer />

    {
      isMockMode && (
        <div
          class="fixed bottom-3 left-3 z-40 max-w-xs border border-ink/20 bg-cream/95 px-3 py-2 text-[11px] leading-snug backdrop-blur"
          data-mock-banner
        >
          <strong class="text-brick">DEMO</strong> — {t('cart.mockNotice')}
          <button
            type="button"
            class="ml-2 underline"
            onclick="this.closest('[data-mock-banner]').remove()"
            aria-label="Dismiss"
          >
            ✕
          </button>
        </div>
      )
    }

  </body>
</html>
