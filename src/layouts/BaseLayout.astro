---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { getLangFromUrl, useTranslations, switchLocalePath } from '../i18n/utils';
import { isMockMode } from '../lib/shopify/config';
import { safeScriptJson } from '../lib/safeScriptJson';

interface Props {
  title?: string;
  description?: string;
  /** Optional OG image URL */
  image?: string;
  alternatePaths?: Partial<Record<'cs' | 'en', string>>;
}

const { title, description, image, alternatePaths } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = 'Kafe Grohova';
const pageTitle = title ? `${title} — ${siteName}` : siteName;
const pageDescription =
  description ??
  (lang === 'cs'
    ? 'Espresso bar a baristické kurzy na Grohové v Brně. Latte art, cupping a příprava filtrované kávy v malých skupinách.'
    : 'Espresso bar and barista courses on Grohova in Brno. Latte art, cupping and filter coffee in small groups.');

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const csHref = new URL(alternatePaths?.cs ?? switchLocalePath(Astro.url, 'cs'), canonical);
const enHref = new URL(alternatePaths?.en ?? switchLocalePath(Astro.url, 'en'), canonical);
const ogLocale = lang === 'cs' ? 'cs_CZ' : 'en_US';
const ogLocaleAlt = lang === 'cs' ? 'en_US' : 'cs_CZ';

const siteOrigin = String(Astro.site ?? Astro.url.origin);
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  '@id': `${siteOrigin}#business`,
  name: siteName,
  image: new URL('/expressobar.webp', siteOrigin).href,
  url: siteOrigin,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Grohova 102/3',
    addressLocality: 'Brno',
    postalCode: '602 00',
    addressCountry: 'CZ',
  },
  areaServed: {
    '@type': 'City',
    name: 'Brno',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '07:00',
    closes: '17:00',
  },
  servesCuisine: 'Coffee',
  priceRange: '$$',
  sameAs: ['https://instagram.com/kafegrohova'],
};
---

<!doctype html>
<html lang={lang === 'cs' ? 'cs' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {isMockMode && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="cs" href={csHref.href} />
    <link rel="alternate" hreflang="en" href={enHref.href} />
    <link rel="alternate" hreflang="x-default" href={csHref.href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href="/fonts/dince-regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FDEDC3" />
    <script type="application/ld+json" is:inline set:html={safeScriptJson(localBusiness)} />
  </head>

  <body class="antialiased p-3 bg-cream text-ink min-h-screen w-full">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-cream focus:p-3">{t('common.skip')}</a>
    <div class="container">
      {isMockMode && (
        <div class="mb-3 flex items-center justify-between gap-3 border border-ink/20 px-3 py-2 text-[12px] leading-snug" data-mock-banner>
          <p><strong class="text-brick">DEMO</strong> — {t('cart.mockNotice')}</p>
          <button type="button" class="shrink-0 px-2 py-1" onclick="this.closest('[data-mock-banner]').remove()" aria-label={lang === 'cs' ? 'Zavřít oznámení' : 'Dismiss notice'}>✕</button>
        </div>
      )}
      <Navbar alternatePaths={alternatePaths} />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <CartDrawer />

  </body>
</html>
