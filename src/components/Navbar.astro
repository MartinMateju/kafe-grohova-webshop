---
import SiteNavigation from './SiteNavigation.astro';
import { getLangFromUrl, type Lang } from '../i18n/utils';
interface Props { alternatePaths?: Partial<Record<Lang, string>>; }
const { alternatePaths } = Astro.props;
---
<SiteNavigation lang={getLangFromUrl(Astro.url)} alternatePaths={alternatePaths} />
