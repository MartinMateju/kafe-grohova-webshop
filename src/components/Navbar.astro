---
import {
  getLangFromUrl,
  useTranslations,
  localePath,
  switchLocalePath,
} from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = Astro.url.pathname;

// Top nav is intentionally lean — Store + Courses only.
// Blog & Contact live in the footer.
const navigation = [
  { label: t('nav.store'), href: localePath(lang, '/store') },
  { label: t('nav.courses'), href: localePath(lang, '/courses') },
];

const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const other = lang === 'cs' ? 'en' : 'cs';
const otherHref = switchLocalePath(Astro.url, other);
const otherLabel = other.toUpperCase();

const linkBase =
  'group relative text-[13px] uppercase tracking-[0.14em] leading-none transition-colors duration-200';
const underline =
  'after:absolute after:left-0 after:-bottom-1.5 after:h-px after:bg-brick after:transition-all after:duration-300';
---

<header class="sticky top-0 z-40 -mx-3 bg-cream/90 px-3 backdrop-blur">
  {/* ── DESKTOP ───────────────────────────────────────────────── */}
  <div
    class="hidden w-full flex-row items-center justify-between gap-6 border-b border-ink/15 py-5 md:flex"
  >
    <a
      href={localePath(lang, '/')}
      class="whitespace-nowrap text-2xl font-normal leading-none tracking-tight text-ink transition-colors hover:text-brick xl:text-[56px]"
    >
      KAFE GROHOVA
    </a>

    <nav class="flex flex-row items-center gap-8 xl:gap-10" aria-label="Main">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              linkBase,
              underline,
              isActive(item.href)
                ? 'text-brick after:w-full'
                : 'text-ink hover:text-brick after:w-0 hover:after:w-full',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <button
        type="button"
        data-cart-toggle
        class:list={[
          linkBase,
          underline,
          'flex items-center gap-1.5 text-ink hover:text-brick after:w-0 hover:after:w-full',
        ]}
      >
        {t('nav.cart')}
        <span data-cart-count class="text-[11px] text-brick" hidden></span>
      </button>

      <span class="h-3 w-px bg-ink/20" aria-hidden="true"></span>

      <a
        href={otherHref}
        hreflang={other}
        class="text-[13px] uppercase tracking-[0.14em] leading-none text-ink/50 transition-colors hover:text-ink"
      >
        {otherLabel}
      </a>
    </nav>
  </div>

  {/* ── MOBILE ────────────────────────────────────────────────── */}
  <div class="w-full md:hidden" data-mobile-nav>
    <div class="flex w-full flex-row items-center justify-between py-3">
      <button
        type="button"
        data-menu-toggle
        data-menu-open={t('nav.menu')}
        data-menu-close={t('nav.close')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex items-center text-[13px] font-semibold uppercase tracking-[0.18em] text-ink focus:outline-none"
      >
        <span data-menu-label>{t('nav.menu')}</span>
      </button>

      <button
        type="button"
        data-cart-toggle
        class="flex items-center gap-1 text-[13px] font-semibold uppercase tracking-[0.18em] text-ink"
      >
        {t('nav.cart')}
        <span data-cart-count class="text-[11px] text-brick" hidden></span>
      </button>
    </div>

    <a
      href={localePath(lang, '/')}
      class="flex w-full flex-row items-center justify-between border-t border-ink/15 pt-2 text-[clamp(2.25rem,13vw,3.5rem)] leading-none tracking-tight"
    >
      <span>KAFE</span>
      <span>GROHOVA</span>
    </a>

    <div
      id="mobile-menu"
      hidden
      class="mt-3 flex flex-col gap-4 border-t border-ink/15 py-5"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-[22px] uppercase tracking-wide transition-colors duration-150',
              isActive(item.href) ? 'text-brick' : 'text-ink hover:text-brick',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={otherHref}
        hreflang={other}
        class="text-[15px] uppercase tracking-[0.14em] text-ink/50 hover:text-ink"
      >
        {otherLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-mobile-nav]');
  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const label = nav.querySelector<HTMLElement>('[data-menu-label]');
    const menu = nav.querySelector<HTMLElement>('#mobile-menu');
    const openText = toggle?.dataset.menuOpen ?? label?.textContent ?? '☰ MENU';
    const closeText = toggle?.dataset.menuClose ?? '✕ CLOSE';

    toggle?.addEventListener('click', () => {
      if (!menu || !label) return;
      const isOpen = !menu.hidden;
      menu.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      label.textContent = isOpen ? openText : closeText;
    });
  }
</script>
