---
import { MERCH_ENABLED, GIFT_CARDS_ENABLED } from '../lib/shopify/config';
import {
  getLangFromUrl,
  useTranslations,
  localePath,
  switchLocalePath,
} from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
interface Props { alternatePaths?: Partial<Record<'cs' | 'en', string>> }
const { alternatePaths } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;

const navigation = [
  { label: t('nav.courses'), href: localePath(lang, '/courses') },
  ...(GIFT_CARDS_ENABLED ? [{ label: t('nav.giftCards'), href: localePath(lang, '/gift-cards') }] : []),
  ...(MERCH_ENABLED ? [{ label: t('nav.store'), href: localePath(lang, '/store') }] : []),
  { label: t('nav.blog'), href: localePath(lang, '/blog') },
  { label: t('nav.contact'), href: localePath(lang, '/contact') },
];

const isActive = (href: string) => path === href || path.startsWith(href);

const other = lang === 'cs' ? 'en' : 'cs';
const otherHref = alternatePaths?.[other] ?? switchLocalePath(Astro.url, other);
const otherLabel = other.toUpperCase();
---

<header>
  {/* ── DESKTOP ───────────────────────────────────────────────── */}
  <div class="relative hidden w-full flex-row items-start justify-between gap-6 lg:flex">
    <a
      href={localePath(lang, '/')}
      class="relative -top-1 cursor-pointer whitespace-nowrap text-2xl leading-none text-ink transition-colors hover:text-brick xl:text-4xl"
    >
      KAFE GROHOVA
    </a>

    <div class="hidden flex-row gap-4 whitespace-nowrap text-[15px] text-ink 2xl:flex xl:text-[18px]">
      <p>{t('nav.sub1')}</p>
      <p>{MERCH_ENABLED ? t('nav.sub2') : t('nav.subCourses')}</p>
    </div>

    <nav class="flex flex-row items-start gap-4 xl:gap-5" aria-label="Main">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap text-[14px] leading-none transition-colors duration-200 lg:text-[16px] xl:text-[18px]',
              isActive(item.href) ? 'text-brick' : 'text-ink hover:text-brick',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <button
        type="button"
        data-cart-toggle
        class="flex items-center gap-1 whitespace-nowrap text-[14px] leading-none text-ink transition-colors duration-200 hover:text-brick lg:text-[16px] xl:text-[18px]"
      >
        {t('nav.cart')}
        <span data-cart-count class="text-[12px]" hidden></span>
      </button>

      <a
        href={otherHref}
        class="whitespace-nowrap text-[14px] leading-none text-ink transition-colors duration-200 hover:text-brick lg:text-[16px] xl:text-[18px]"
        hreflang={other}
      >
        {otherLabel}
      </a>
    </nav>
  </div>

  {/* ── MOBILE ────────────────────────────────────────────────── */}
  <div class="lg:hidden w-full pb-2.5" data-mobile-nav>
    <div class="flex flex-row justify-between items-center w-full py-3 px-4">
      <button
        type="button"
        data-menu-toggle
        data-close-label={t('nav.close')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="text-ink text-[14px] font-semibold tracking-widest focus:outline-none"
      >
        <span data-menu-label>{t('nav.menu')}</span>
      </button>

      <button
        type="button"
        data-cart-toggle
        class="text-[20px] font-bold text-ink leading-none flex items-center gap-1"
      >
        {t('nav.cart')}
        <span data-cart-count class="text-sm" hidden></span>
      </button>
    </div>

    <hr class="border-ink/30" />

    <a
      href={localePath(lang, '/')}
      class="flex flex-row items-center justify-between w-full text-[clamp(26px,9vw,40px)] leading-none"
    >
      <span>KAFE</span>
      <span>GROHOVA</span>
    </a>

    <div
      id="mobile-menu"
      hidden
      class="flex flex-col bg-white border-t border-ink px-4 py-4 gap-4"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-[18px] font-medium tracking-wide transition-colors duration-150',
              isActive(item.href) ? 'text-brick' : 'text-ink hover:text-brick',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href={otherHref} hreflang={other} class="text-[18px] text-ink hover:text-brick">
        {otherLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-mobile-nav]');
  if (nav) {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const label = nav.querySelector<HTMLElement>('[data-menu-label]');
    const menu = nav.querySelector<HTMLElement>('#mobile-menu');
    const openText = label?.textContent ?? '☰ MENU';
    const closeText = toggle?.dataset.closeLabel ?? openText;

    toggle?.addEventListener('click', () => {
      if (!menu || !label) return;
      const isOpen = !menu.hidden;
      menu.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      label.textContent = isOpen ? openText : closeText;
    });
  }
</script>
