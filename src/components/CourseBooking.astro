---
import { safeScriptJson } from '../lib/safeScriptJson';
import { isFutureCourseDate } from '../lib/courseAvailability';
import { isMockMode } from '../lib/shopify/config';
import type { Product } from '../lib/shopify';
import { formatDateTime, formatMoney, imageUrl } from '../lib/shopify';
import { useTranslations, localePath, type Lang } from '../i18n/utils';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);

/** Seat wording has three Czech forms; English has two. */
function seatWord(n: number): string {
  if (lang === 'en') return n === 1 ? t('courses.seatLeft') : t('courses.seatsLeft');
  if (n === 1) return t('courses.seatLeft');
  if (n >= 2 && n <= 4) return t('courses.seatsLeft2');
  return t('courses.seatsLeft');
}

const dates = product.variants
  .map((v) => ({
    id: v.id,
    title: v.title,
    available: v.availableForSale && isFutureCourseDate(v.startsAt) && (v.quantityAvailable === null || v.quantityAvailable > 0),
    seats: v.quantityAvailable,
    startsAt: v.startsAt,
    label: v.startsAt ? formatDateTime(v.startsAt, lang) : v.title,
    priceLabel: formatMoney(v.price, lang),
    amount: v.price.amount,
    currencyCode: v.price.currencyCode,
  }))
  .sort((a, b) => {
    if (a.startsAt && b.startsAt) return Date.parse(a.startsAt) - Date.parse(b.startsAt);
    return 0;
  });

const anyAvailable = dates.some((d) => d.available);
const firstAvailable = dates.find((d) => d.available);

const snapshotBase = {
  productTitle: product.title,
  productHandle: product.handle,
  imageUrl: imageUrl(product.featuredImage?.url, 300),
};

const labels = {
  book: t('courses.book'),
  adding: t('product.adding'),
  added: t('product.added'),
  soldOut: t('courses.soldOut'),
  unavailable: t('courses.unavailable'),
  loading: t('common.loading'),
  availabilityError: t('product.availabilityError'),
  retry: t('product.retry'),
  seat: t('courses.seatLeft'),
  seats2: t('courses.seatsLeft2'),
  seats: t('courses.seatsLeft'),
};
---

<div class="flex flex-col gap-6" data-course-booking>
  <div class="flex flex-col gap-3">
    <span class="label text-ink/60">{t('courses.pickDate')}</span>

    {
      dates.length === 0 && (
        <div class="border border-ink/20 px-5 py-6">
          <p class="text-[16px]">{t('courses.noDates')}</p>
          <a href={localePath(lang, '/contact')} class="mt-2 inline-block text-brick underline">
            {t('courses.notifyMe')}
          </a>
        </div>
      )
    }

    <ul class="flex flex-col divide-y divide-ink/15 border border-ink/25">
      {
        dates.map((date) => (
          <li>
            <button
              type="button"
              data-date={date.id}
              disabled={!isMockMode || !date.available}
              aria-pressed={date.id === firstAvailable?.id ? 'true' : 'false'}
              class:list={[
                'flex w-full items-center justify-between gap-4 px-4 py-4 text-left transition-colors',
                date.available
                  ? 'hover:bg-ink/5 aria-pressed:bg-ink aria-pressed:text-cream'
                  : 'cursor-not-allowed text-ink/35',
              ]}
            >
              <span class="flex flex-col gap-0.5">
                <span data-date-label class="text-[16px] md:text-[18px]">{date.label}</span>
                <span data-date-stock class="text-[12px] opacity-70">
                  {date.available
                    ? typeof date.seats === 'number'
                      ? `${date.seats} ${seatWord(date.seats)}`
                      : ''
                    : isFutureCourseDate(date.startsAt) ? labels.soldOut : labels.unavailable}
                </span>
              </span>
              <span data-date-price class="whitespace-nowrap text-[15px]">{date.priceLabel}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {
    dates.length > 0 && (
      <div class="flex flex-wrap items-stretch gap-3">
        <div class="flex items-center border border-ink">
          <button type="button" data-seat-down class="px-4 py-3 text-lg leading-none hover:text-brick" aria-label="−">
            −
          </button>
          <input
            type="number"
            data-seats
            value="1"
            min="1"
            max="99"
            class="w-14 border-0 bg-transparent text-center text-[16px] outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none"
            aria-label={t('courses.seatsLeft')}
          />
          <button type="button" data-seat-up class="px-4 py-3 text-lg leading-none hover:text-brick" aria-label="+">
            +
          </button>
        </div>

        <button
          type="button"
          data-book
          disabled={!isMockMode || !anyAvailable}
          class="flex-1 min-w-[12rem] border border-ink bg-brick px-6 py-3 tracking-widest text-cream transition-colors hover:bg-ink disabled:cursor-not-allowed disabled:opacity-40"
        >
          {!isMockMode ? labels.loading : anyAvailable ? labels.book : labels.soldOut}
        </button>
      </div>
    )
  }
  <p data-availability-error role="alert" class="text-[13px] text-brick" hidden></p>
  <button type="button" data-retry class="self-start text-brick underline" hidden>{labels.retry}</button>
</div>

<script
  is:inline
  type="application/json"
  data-course-booking-data
  set:html={safeScriptJson({ dates, snapshotBase, labels, lang })}
/>

<script>
  import { addLine, isMockMode } from '../lib/cart';
  import { getProduct, formatMoney, formatDateTime } from '../lib/shopify';
  import { isFutureCourseDate } from '../lib/courseAvailability';

  const root = document.querySelector<HTMLElement>('[data-course-booking]');
  const dataEl = document.querySelector<HTMLScriptElement>('[data-course-booking-data]');

  if (root && dataEl) {
    const data = JSON.parse(dataEl.textContent!);
    const { snapshotBase, labels, lang } = data;
    let dates = data.dates;
    const seatsInput = root.querySelector<HTMLInputElement>('[data-seats]');
    const bookBtn = root.querySelector<HTMLButtonElement>('[data-book]');
    const errorEl = root.querySelector<HTMLElement>('[data-availability-error]')!;
    const retryBtn = root.querySelector<HTMLButtonElement>('[data-retry]')!;
    const dateBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-date]'));
    const bookable = (date: any) => date?.available && isFutureCourseDate(date.startsAt) &&
      (date.seats === null || date.seats > 0);
    let selected = dates.find(bookable) ?? null;
    let ready = isMockMode;
    let busy = false;

    const clampSeats = () => {
      if (!seatsInput) return 1;
      const max = typeof selected?.seats === 'number' ? Math.max(1, Math.min(99, selected.seats)) : 99;
      const n = Math.max(1, Math.min(max, Math.floor(Number(seatsInput.value)) || 1));
      seatsInput.max = String(max);
      seatsInput.value = String(n);
      return n;
    };

    const syncUI = () => {
      if (!bookable(selected)) selected = dates.find(bookable) ?? null;
      dateBtns.forEach((btn) => {
        const date = dates.find((d: any) => d.id === btn.dataset.date);
        btn.disabled = busy || !ready || !bookable(date);
        btn.classList.toggle('text-ink/35', !bookable(date));
        btn.setAttribute('aria-pressed', String(btn.dataset.date === selected?.id));
        if (!date) return;
        btn.querySelector<HTMLElement>('[data-date-label]')!.textContent = date.label;
        btn.querySelector<HTMLElement>('[data-date-price]')!.textContent = date.priceLabel;
        const stock = btn.querySelector<HTMLElement>('[data-date-stock]')!;
        const word = date.seats === 1 ? labels.seat : lang === 'cs' && date.seats >= 2 && date.seats <= 4 ? labels.seats2 : labels.seats;
        stock.textContent = !isFutureCourseDate(date.startsAt) ? labels.unavailable
          : !date.available ? labels.soldOut : !ready ? labels.loading
          : typeof date.seats === 'number' ? `${date.seats} ${word}` : '';
      });
      const available = ready && bookable(selected);
      if (bookBtn) {
        bookBtn.disabled = busy || !available;
        bookBtn.textContent = busy ? labels.adding : !ready ? labels.loading : available ? labels.book : labels.soldOut;
      }
      if (seatsInput) seatsInput.disabled = busy || !available;
      root.querySelectorAll<HTMLButtonElement>('[data-seat-up], [data-seat-down]').forEach((button) => {
        button.disabled = busy || !available;
      });
      clampSeats();
    };

    const refreshAvailability = async () => {
      if (isMockMode) return;
      ready = false;
      errorEl.hidden = true;
      retryBtn.hidden = true;
      syncUI();
      try {
        const product = await getProduct(snapshotBase.productHandle, lang);
        dates = dates.map((previous: any) => {
          const current = product?.variants.find((variant) => variant.id === previous.id);
          return current ? {
            id: current.id, title: current.title, available: current.availableForSale,
            seats: current.quantityAvailable, startsAt: current.startsAt,
            label: current.startsAt ? formatDateTime(current.startsAt, lang) || current.title : current.title,
            amount: current.price.amount, currencyCode: current.price.currencyCode,
            priceLabel: formatMoney(current.price, lang),
          } : { ...previous, available: false };
        });
        selected = dates.find((date: any) => date.id === selected?.id && bookable(date))
          ?? dates.find(bookable) ?? null;
        ready = true;
      } catch {
        errorEl.textContent = labels.availabilityError;
        errorEl.hidden = false;
        retryBtn.hidden = false;
      }
      syncUI();
    };

    retryBtn.addEventListener('click', () => { void refreshAvailability(); });
    dateBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (busy || !ready) return;
        const match = dates.find((date: any) => date.id === btn.dataset.date);
        if (bookable(match)) { selected = match; syncUI(); }
      });
    });
    root.querySelector('[data-seat-up]')?.addEventListener('click', () => {
      if (seatsInput) { seatsInput.value = String(clampSeats() + 1); clampSeats(); }
    });
    root.querySelector('[data-seat-down]')?.addEventListener('click', () => {
      if (seatsInput) seatsInput.value = String(Math.max(1, clampSeats() - 1));
    });
    seatsInput?.addEventListener('change', clampSeats);

    bookBtn?.addEventListener('click', async () => {
      // Recheck at the actual click, even if the static page was left open overnight.
      if (busy || !ready || !bookable(selected)) { syncUI(); return; }
      busy = true;
      syncUI();
      const success = await addLine({
        ...snapshotBase, merchandiseId: selected.id, variantTitle: selected.label,
        amount: selected.amount, currencyCode: selected.currencyCode,
        quantityAvailable: selected.seats, startsAt: selected.startsAt,
      }, clampSeats());
      if (success) {
        busy = false;
        syncUI();
        bookBtn.textContent = labels.added;
        window.setTimeout(() => { if (!busy) syncUI(); }, 1400);
      } else {
        busy = false;
        syncUI();
      }
    });

    syncUI();
    void refreshAvailability();
    window.setInterval(() => { if (!busy) syncUI(); }, 30_000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && !busy) syncUI();
    });
  }
</script>
