---
import type { Product } from '../lib/shopify';
import { formatMoney, imageUrl } from '../lib/shopify';
import { localePath, type Lang } from '../i18n/utils';

interface Props {
  product: Product;
  lang: Lang;
  heightClass?: string;
  soldOutLabel?: string;
  section?: 'store' | 'gift-cards';
}
const { product, lang, heightClass = 'h-[45vw] md:h-[clamp(12rem,28vw,21rem)]', soldOutLabel, section = 'store' } = Astro.props;
const price = formatMoney(product.priceRange.minVariantPrice, lang);
const src = imageUrl(product.featuredImage?.url, 900);
const alt = product.featuredImage?.altText ?? product.title;
const soldOut = !product.availableForSale;
---

<a href={localePath(lang, `/${section}/${product.handle}`)} class="editorial-product" data-product-card={product.handle}>
  <div class:list={['product-image', heightClass, { 'gift-image': section === 'gift-cards' }]}>
    {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <div class="image-empty" />}
    {soldOut && soldOutLabel && <span class="sold-out">{soldOutLabel}</span>}
  </div>
  <div class="product-caption"><span class="product-name">{product.title}</span><span class="product-amount">{price}</span></div>
</a>

<style>
  .editorial-product { display: flex; flex-direction: column; gap: 1rem; min-width: 0; color: var(--color-ink); }
  .product-image { position: relative; width: 100%; overflow: hidden; background: color-mix(in srgb, var(--color-ink) 5%, transparent); }
  .product-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .gift-image img { object-fit: contain; padding: .75rem; }
  .image-empty { width: 100%; height: 100%; }
  .editorial-product:hover img { transform: scale(1.025); }
  .product-caption { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-top: .9rem; border-top: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent); }
  .product-name { font-family: Arial, sans-serif; font-size: clamp(1rem, 1.5vw, 1.3rem); line-height: 1.3; font-weight: 700; letter-spacing: -.025em; overflow-wrap: anywhere; }
  .product-amount { flex-shrink: 0; font-family: var(--font-display); font-size: .95rem; white-space: nowrap; }
  .editorial-product:hover .product-name { color: var(--color-brick); }
  .sold-out { position: absolute; top: .75rem; left: .75rem; max-width: calc(100% - 1.5rem); background: var(--color-brick); color: var(--color-cream); padding: .5rem .75rem; font-family: var(--font-display); font-size: .7rem; letter-spacing: .08em; }
  @media (max-width: 600px) { .product-caption { flex-wrap: wrap; gap: .5rem; } .product-name { font-size: 1.15rem; } }
</style>
