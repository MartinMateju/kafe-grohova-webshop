---
import { safeScriptJson } from '../lib/safeScriptJson';
import { isMockMode } from '../lib/shopify/config';
import type { Product } from '../lib/shopify';
import { formatMoney, imageUrl } from '../lib/shopify';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);

const hasRealOptions =
  product.options.length > 0 &&
  !(product.options.length === 1 && product.options[0].name === 'Title');

const variants = product.variants.map((v) => ({
  id: v.id,
  title: v.title,
  available: v.availableForSale,
  quantityAvailable: v.quantityAvailable,
  amount: v.price.amount,
  currencyCode: v.price.currencyCode,
  priceLabel: formatMoney(v.price, lang),
}));

const snapshotBase = {
  productTitle: product.title,
  productHandle: product.handle,
  imageUrl: imageUrl(product.featuredImage?.url, 300),
};

const labels = {
  add: t('product.addToCart'),
  adding: t('product.adding'),
  added: t('product.added'),
  soldOut: t('product.soldOut'),
  stockLeft: t('product.stockLeft'),
  loading: t('common.loading'),
  availabilityError: t('product.availabilityError'),
  retry: t('product.retry'),
};

const firstAvailable = variants.find((v) => v.available) ?? variants[0];
---

<div class="flex flex-col gap-5" data-add-to-cart>
  {
    hasRealOptions && variants.length > 1 && (
      <div class="flex flex-col gap-2">
        <span class="label text-ink/60">{product.options[0]?.name}</span>
        <div class="flex flex-wrap gap-2">
          {variants.map((variant) => (
            <button
              type="button"
              data-variant={variant.id}
              disabled={!variant.available}
              aria-pressed={variant.id === firstAvailable?.id ? 'true' : 'false'}
              class:list={[
                'border px-4 py-2 text-[14px] transition-colors',
                variant.available
                  ? 'border-ink hover:bg-ink hover:text-cream aria-pressed:bg-ink aria-pressed:text-cream'
                  : 'border-ink/20 text-ink/30 line-through cursor-not-allowed',
              ]}
            >
              {variant.title}
            </button>
          ))}
        </div>
      </div>
    )
  }

  <div class="flex flex-wrap items-stretch gap-3">
    <div class="flex items-center border border-ink">
      <button
        type="button"
        data-qty-down
        class="px-4 py-3 text-lg leading-none hover:text-brick"
        aria-label="−"
      >
        −
      </button>
      <input
        type="number"
        data-qty
        value="1"
        min="1"
        max="99"
        class="w-14 border-0 bg-transparent text-center text-[16px] outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none"
        aria-label={t('product.quantity')}
      />
      <button
        type="button"
        data-qty-up
        class="px-4 py-3 text-lg leading-none hover:text-brick"
        aria-label="+"
      >
        +
      </button>
    </div>

    <button
      type="button"
      data-add
      disabled={!isMockMode || !firstAvailable?.available}
      class="flex-1 min-w-[12rem] border border-ink bg-ink px-6 py-3 text-cream tracking-widest transition-colors hover:bg-brick hover:border-brick disabled:cursor-not-allowed disabled:opacity-40"
    >
      {!isMockMode ? labels.loading : firstAvailable?.available ? labels.add : labels.soldOut}
    </button>
  </div>

  <p data-stock class="text-[13px] text-ink/60"></p>
  <p data-availability-error role="alert" class="text-[13px] text-brick" hidden></p>
  <button type="button" data-retry class="self-start text-brick underline" hidden>{labels.retry}</button>
</div>

<script
  is:inline
  type="application/json"
  data-add-to-cart-data
  set:html={safeScriptJson({ variants, snapshotBase, labels, lang })}
/>

<script>
  import { addLine, isMockMode } from '../lib/cart';
  import { getProduct, formatMoney } from '../lib/shopify';

  const root = document.querySelector<HTMLElement>('[data-add-to-cart]');
  const dataEl = document.querySelector<HTMLScriptElement>('[data-add-to-cart-data]');

  if (root && dataEl) {
    const data = JSON.parse(dataEl.textContent!);
    const { snapshotBase, labels, lang } = data;
    let variants = data.variants;
    const qtyInput = root.querySelector<HTMLInputElement>('[data-qty]')!;
    const addBtn = root.querySelector<HTMLButtonElement>('[data-add]')!;
    const stockEl = root.querySelector<HTMLElement>('[data-stock]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-availability-error]')!;
    const retryBtn = root.querySelector<HTMLButtonElement>('[data-retry]')!;
    const variantBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-variant]'));
    let selected = variants.find((v: any) => v.available) ?? variants[0] ?? null;
    let ready = isMockMode;
    let busy = false;

    const clampQty = () => {
      const max = typeof selected?.quantityAvailable === 'number'
        ? Math.max(1, Math.min(99, selected.quantityAvailable)) : 99;
      const n = Math.max(1, Math.min(max, Math.floor(Number(qtyInput.value)) || 1));
      qtyInput.max = String(max);
      qtyInput.value = String(n);
      return n;
    };

    const syncUI = () => {
      variantBtns.forEach((btn) => {
        const variant = variants.find((v: any) => v.id === btn.dataset.variant);
        btn.disabled = busy || !ready || !variant?.available;
        btn.classList.toggle('line-through', !variant?.available);
        btn.setAttribute('aria-pressed', String(btn.dataset.variant === selected?.id));
      });
      const available = ready && Boolean(selected?.available);
      addBtn.disabled = busy || !available;
      addBtn.textContent = busy ? labels.adding : !ready ? labels.loading : available ? labels.add : labels.soldOut;
      qtyInput.disabled = busy || !available;
      root.querySelectorAll<HTMLButtonElement>('[data-qty-up], [data-qty-down]').forEach((button) => {
        button.disabled = busy || !available;
      });
      const qty = selected?.quantityAvailable;
      stockEl.textContent = available && typeof qty === 'number' && qty > 0 && qty < 11
        ? labels.stockLeft.replace('{n}', String(qty)) : '';
      const priceEl = document.querySelector<HTMLElement>('[data-product-price]');
      if (priceEl && selected?.priceLabel) priceEl.textContent = selected.priceLabel;
      clampQty();
    };

    const refreshAvailability = async () => {
      if (isMockMode) return;
      ready = false;
      errorEl.hidden = true;
      retryBtn.hidden = true;
      syncUI();
      try {
        const product = await getProduct(snapshotBase.productHandle, lang);
        variants = variants.map((previous: any) => {
          const current = product?.variants.find((variant) => variant.id === previous.id);
          return current ? {
            id: current.id, title: current.title,
            available: current.availableForSale && (current.quantityAvailable === null || current.quantityAvailable > 0),
            quantityAvailable: current.quantityAvailable, amount: current.price.amount,
            currencyCode: current.price.currencyCode, priceLabel: formatMoney(current.price, lang),
          } : { ...previous, available: false };
        });
        selected = variants.find((variant: any) => variant.id === selected?.id && variant.available)
          ?? variants.find((variant: any) => variant.available) ?? variants[0] ?? null;
        ready = true;
      } catch {
        errorEl.textContent = labels.availabilityError;
        errorEl.hidden = false;
        retryBtn.hidden = false;
      }
      syncUI();
    };

    retryBtn.addEventListener('click', () => { void refreshAvailability(); });
    variantBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (busy || !ready) return;
        const match = variants.find((v: any) => v.id === btn.dataset.variant);
        if (match?.available) { selected = match; syncUI(); }
      });
    });
    root.querySelector('[data-qty-up]')?.addEventListener('click', () => {
      qtyInput.value = String(clampQty() + 1); clampQty();
    });
    root.querySelector('[data-qty-down]')?.addEventListener('click', () => {
      qtyInput.value = String(Math.max(1, clampQty() - 1));
    });
    qtyInput.addEventListener('change', clampQty);

    addBtn.addEventListener('click', async () => {
      if (busy || !ready || !selected?.available) return;
      busy = true;
      syncUI();
      const success = await addLine({
        ...snapshotBase, merchandiseId: selected.id, variantTitle: selected.title,
        amount: selected.amount, currencyCode: selected.currencyCode,
        quantityAvailable: selected.quantityAvailable,
      }, clampQty());
      if (success) {
        busy = false;
        syncUI();
        addBtn.textContent = labels.added;
        window.setTimeout(() => { if (!busy) syncUI(); }, 1400);
      } else {
        busy = false;
        syncUI();
      }
    });

    syncUI();
    void refreshAvailability();
  }
</script>
