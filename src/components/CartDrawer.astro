---
import { safeScriptJson } from '../lib/safeScriptJson';
import { getLangFromUrl, useTranslations, localePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const strings = {
  title: t('cart.title'),
  empty: t('cart.empty'),
  continue: t('cart.continue'),
  subtotal: t('cart.subtotal'),
  checkout: t('cart.checkout'),
  remove: t('cart.remove'),
  decrease: t('cart.decrease'),
  increase: t('cart.increase'),
  shippingNote: t('cart.shippingNote'),
  close: t('cart.close'),
  mockNotice: t('cart.mockNotice'),
  loading: t('common.loading'),
  storeHref: localePath(lang, '/store'),
  locale: lang === 'cs' ? 'cs-CZ' : 'en-GB',
};
---

<div data-cart-root>
  <div
    data-cart-backdrop
    hidden
    class="fixed inset-0 z-50 bg-black/40 opacity-0 transition-opacity duration-300"
  >
  </div>

  <aside
    data-cart-panel
    hidden
    role="dialog"
    aria-modal="true"
    tabindex="-1"
    aria-label={strings.title}
    class="fixed right-0 top-0 z-50 flex h-dvh w-full max-w-md translate-x-full flex-col border-l border-ink bg-cream transition-transform duration-300"
  >
    <div class="flex items-center justify-between border-b border-ink px-5 py-4">
      <h2 class="text-2xl">{strings.title}</h2>
      <button
        type="button"
        data-cart-close
        aria-label={strings.close}
        class="text-2xl leading-none hover:text-brick transition-colors"
      >
        ✕
      </button>
    </div>

    <div data-cart-body class="flex-1 overflow-y-auto px-5 py-4">
      <p class="py-10 text-center text-ink/60">{strings.empty}</p>
    </div>

    <p data-cart-error role="alert" class="px-5 pb-3 text-[13px] text-brick" hidden></p>
    <p data-cart-notice role="status" class="px-5 pb-3 text-[13px] text-ink/70" hidden></p>

    <div data-cart-foot class="border-t border-ink px-5 py-4" hidden>
      <div class="mb-1 flex items-center justify-between text-lg">
        <span>{strings.subtotal}</span>
        <span data-cart-subtotal>—</span>
      </div>
      <p class="mb-4 text-[12px] text-ink/60">{strings.shippingNote}</p>
      <button
        type="button"
        data-cart-checkout
        class="w-full border border-ink bg-ink px-4 py-3 text-cream transition-colors hover:bg-brick hover:border-brick disabled:cursor-not-allowed disabled:opacity-50"
      >
        {strings.checkout}
      </button>
    </div>
  </aside>
</div>

<script is:inline type="application/json" data-cart-strings set:html={safeScriptJson(strings)} />

<script>
  import { subscribe, initCart, openCart, closeCart, updateLine, removeLine, checkout, isMockMode } from '../lib/cart';
  import type { Cart } from '../lib/shopify/types';

  const strings = JSON.parse(document.querySelector('[data-cart-strings]')?.textContent ?? '{}');
  const root = document.querySelector<HTMLElement>('[data-cart-root]');
  if (root) {
    const backdrop = root.querySelector<HTMLElement>('[data-cart-backdrop]')!;
    const panel = root.querySelector<HTMLElement>('[data-cart-panel]')!;
    const body = root.querySelector<HTMLElement>('[data-cart-body]')!;
    const foot = root.querySelector<HTMLElement>('[data-cart-foot]')!;
    const subtotalEl = root.querySelector<HTMLElement>('[data-cart-subtotal]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-cart-error]')!;
    const noticeEl = root.querySelector<HTMLElement>('[data-cart-notice]')!;
    const checkoutBtn = root.querySelector<HTMLButtonElement>('[data-cart-checkout]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-cart-close]')!;
    let isOpen = false;
    let loading = false;
    let previousOverflow = '';
    let opener: HTMLElement | null = null;
    let lastTrigger: HTMLElement | null = null;
    let pendingFocus: { id: string; control: string } | null = null;
    const inertSiblings = new Map<HTMLElement, boolean>();

    const money = (amount: string, currencyCode: string) => {
      const n = Number.parseFloat(amount);
      if (!Number.isFinite(n)) return '';
      try {
        return new Intl.NumberFormat(strings.locale ?? 'cs-CZ', {
          style: 'currency', currency: currencyCode, maximumFractionDigits: n % 1 === 0 ? 0 : 2,
        }).format(n);
      } catch { return `${n} ${currencyCode}`; }
    };
    const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
    );
    const imageSource = (value: string) => {
      try {
        const url = new URL(value, document.baseURI);
        return ['https:', 'http:'].includes(url.protocol) ? escapeHtml(url.href) : '';
      } catch { return ''; }
    };
    const focusable = () => Array.from(panel.querySelectorAll<HTMLElement>(
      'a[href], button:not(:disabled), input:not(:disabled), [tabindex]:not([tabindex="-1"])',
    )).filter((el) => !el.hidden && el.getClientRects().length > 0);

    const setOpen = (open: boolean) => {
      document.querySelectorAll<HTMLElement>('[data-cart-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
      });
      if (open === isOpen) return;
      isOpen = open;
      if (open) {
        opener = lastTrigger ?? (document.activeElement instanceof HTMLElement ? document.activeElement : null);
        lastTrigger = null;
        previousOverflow = document.body.style.overflow;
        for (const sibling of Array.from(document.body.children)) {
          if (sibling instanceof HTMLElement && sibling !== root && !sibling.contains(root) && sibling.tagName !== 'SCRIPT') {
            inertSiblings.set(sibling, sibling.inert);
            sibling.inert = true;
          }
        }
        backdrop.hidden = false;
        panel.hidden = false;
        panel.inert = false;
        requestAnimationFrame(() => {
          if (!isOpen) return;
          backdrop.classList.remove('opacity-0');
          panel.classList.remove('translate-x-full');
          closeBtn.focus();
        });
        document.body.style.overflow = 'hidden';
      } else {
        backdrop.classList.add('opacity-0');
        panel.classList.add('translate-x-full');
        panel.inert = true;
        document.body.style.overflow = previousOverflow;
        inertSiblings.forEach((wasInert, element) => { element.inert = wasInert; });
        inertSiblings.clear();
        const target = opener?.isConnected && !opener.matches(':disabled') ? opener
          : document.querySelector<HTMLElement>('[data-cart-toggle]');
        target?.focus();
        window.setTimeout(() => {
          if (!isOpen) { backdrop.hidden = true; panel.hidden = true; }
        }, window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300);
      }
    };

    const renderLines = (cart: Cart | null) => {
      const active = document.activeElement;
      if (active instanceof HTMLElement && body.contains(active)) {
        const row = active.closest<HTMLElement>('[data-line]');
        const control = ['data-qty-down', 'data-qty-up', 'data-line-remove'].find((attr) => active.hasAttribute(attr));
        if (row?.dataset.line && control) pendingFocus = { id: row.dataset.line, control };
      }
      if (!cart?.lines.length) {
        body.innerHTML = `<div class="flex flex-col items-center gap-4 py-16 text-center">
          <p class="text-lg text-ink/70">${escapeHtml(strings.empty)}</p>
          <a href="${escapeHtml(strings.storeHref)}" class="text-brick underline">${escapeHtml(strings.continue)}</a>
        </div>`;
        foot.hidden = true;
      } else {
        body.innerHTML = cart.lines.map((line) => {
          const variant = line.variantTitle && line.variantTitle !== 'Default Title'
            ? `<p class="text-[13px] text-ink/60">${escapeHtml(line.variantTitle)}</p>` : '';
          const source = line.image ? imageSource(line.image.url) : '';
          const image = source
            ? `<img src="${source}" alt="" class="h-24 w-20 object-cover" loading="lazy" />`
            : '<div class="h-24 w-20 bg-ink/5"></div>';
          const disabled = loading ? 'disabled' : '';
          return `<div class="flex gap-4 border-b border-ink/10 py-4" data-line="${escapeHtml(line.id)}">
            ${image}
            <div class="flex min-w-0 flex-1 flex-col justify-between">
              <div><p class="truncate">${escapeHtml(line.productTitle)}</p>${variant}</div>
              <div class="flex items-center justify-between">
                <div class="flex items-center border border-ink/30">
                  <button type="button" class="px-2 py-1 hover:text-brick disabled:opacity-40" data-qty-down aria-label="${escapeHtml(strings.decrease)}" ${disabled}>−</button>
                  <span data-line-quantity class="min-w-8 text-center text-sm">${line.quantity}</span>
                  <button type="button" class="px-2 py-1 hover:text-brick disabled:opacity-40" data-qty-up aria-label="${escapeHtml(strings.increase)}" ${disabled}>+</button>
                </div>
                <span class="text-sm">${escapeHtml(money(line.totalAmount.amount, line.totalAmount.currencyCode))}</span>
              </div>
            </div>
            <button type="button" class="self-start text-ink/40 hover:text-brick disabled:opacity-40" data-line-remove aria-label="${escapeHtml(strings.remove)}" ${disabled}>✕</button>
          </div>`;
        }).join('');
        foot.hidden = false;
        subtotalEl.textContent = money(cart.subtotal.amount, cart.subtotal.currencyCode);
      }
      if (pendingFocus && isOpen) {
        if (loading) panel.focus();
        else {
          const row = Array.from(body.querySelectorAll<HTMLElement>('[data-line]')).find((line) => line.dataset.line === pendingFocus?.id);
          const control = row?.querySelector<HTMLElement>(`[${pendingFocus.control}]`);
          (control ?? closeBtn).focus();
          pendingFocus = null;
        }
      }
    };

    subscribe((state) => {
      loading = state.loading;
      panel.setAttribute('aria-busy', String(loading));
      const count = state.cart?.totalQuantity ?? 0;
      document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
        el.textContent = count > 0 ? `(${count})` : '';
        el.hidden = count === 0;
      });
      renderLines(state.cart);
      errorEl.textContent = state.error ?? '';
      errorEl.hidden = !state.error;
      noticeEl.textContent = state.notice ?? (isMockMode && state.cart?.lines.length ? strings.mockNotice : '') ?? '';
      noticeEl.hidden = !noticeEl.textContent;
      checkoutBtn.disabled = state.loading || isMockMode || !state.cart?.lines.length || !state.cart.checkoutUrl;
      checkoutBtn.textContent = state.loading ? strings.loading : strings.checkout;
      setOpen(state.open);
    });

    // Capture the initiating control before async operations disable it.
    document.addEventListener('click', (event) => {
      if (isOpen || !(event.target instanceof Element)) return;
      const trigger = event.target.closest<HTMLElement>('[data-add], [data-book], [data-cart-toggle]');
      if (trigger) lastTrigger = trigger;
    }, true);
    document.querySelectorAll('[data-cart-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => isOpen ? closeCart() : openCart());
    });
    closeBtn.addEventListener('click', closeCart);
    backdrop.addEventListener('click', closeCart);
    document.addEventListener('keydown', (event) => {
      if (!isOpen) return;
      if (event.key === 'Escape') { event.preventDefault(); closeCart(); }
      if (event.key === 'Tab') {
        const controls = focusable();
        const first = controls[0] ?? panel;
        const last = controls[controls.length - 1] ?? panel;
        if (event.shiftKey && (document.activeElement === first || document.activeElement === panel)) {
          event.preventDefault(); last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || document.activeElement === panel)) {
          event.preventDefault(); first.focus();
        }
      }
    });
    document.addEventListener('focusin', (event) => {
      if (isOpen && event.target instanceof Node && !panel.contains(event.target)) closeBtn.focus();
    });
    body.addEventListener('click', (event) => {
      if (loading || !(event.target instanceof Element)) return;
      const target = event.target;
      const row = target.closest<HTMLElement>('[data-line]');
      if (!row?.dataset.line) return;
      const lineId = row.dataset.line;
      const quantity = Number(row.querySelector('[data-line-quantity]')?.textContent ?? 1);
      if (target.closest('[data-qty-up]')) void updateLine(lineId, quantity + 1);
      else if (target.closest('[data-qty-down]')) void updateLine(lineId, quantity - 1);
      else if (target.closest('[data-line-remove]')) void removeLine(lineId);
    });
    checkoutBtn.addEventListener('click', () => { if (!checkoutBtn.disabled) void checkout(); });
    void initCart();
  }
</script>
