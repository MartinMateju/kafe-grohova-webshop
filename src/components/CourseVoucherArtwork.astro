---
import type { Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cs = lang === 'cs';
---
<figure class="course-voucher-art" aria-label={cs ? 'Ukázka dárkového poukazu na Latte art pro začátečníky, 2 100 Kč za osobu. Bez platného kódu.' : 'Design preview of the beginner latte art voucher, CZK 2,100 per person. No redeemable code.'}>
  <div class="voucher-paper"><img class="voucher-wordmark" src="/brand/logo-black.svg" width="465" height="182" alt="Kafe Grohova" /><span class="voucher-label">{cs ? 'Dárkový poukaz' : 'Gift voucher'}</span><strong>Latte<br />art.</strong><span class="voucher-for">{cs ? 'Pro začátečníky.' : 'For beginners.'}</span><div class="voucher-value"><span>2 100 Kč</span><span>{cs ? 'na osobu' : 'per person'}</span></div><small>{cs ? 'UKÁZKA / BEZ PLATNÉHO KÓDU' : 'PREVIEW / NO REDEEMABLE CODE'}</small></div>
  <img class="voucher-photo" src="/photos/latte-on-table.webp" width="960" height="1440" alt="" loading="lazy" />
</figure>
<style>
.course-voucher-art{display:grid;grid-template-columns:1.2fr 1fr;width:100%;margin:0;background:#f3e8d9;box-shadow:0 16px 45px #29211d12}.voucher-paper{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(20px,3vw,40px);min-width:0;color:#29211d}.voucher-wordmark{width:clamp(100px,12vw,140px);height:auto}.voucher-label{font-size:10px;text-transform:uppercase;letter-spacing:.12em;margin:35px 0 16px}.voucher-paper strong{font:600 clamp(42px,5.5vw,80px)/.93 var(--font-sans);letter-spacing:-.06em}.voucher-for{font-size:clamp(14px,1.6vw,19px);margin-top:14px}.voucher-value{border-top:2px solid #9f4a34;width:100%;padding-top:17px;margin-top:30px;display:flex;flex-wrap:wrap;gap:7px 12px;align-items:baseline}.voucher-value span:first-child{font-size:22px}.voucher-value span:last-child{font-size:12px}.voucher-paper small{font-size:7px;letter-spacing:.08em;margin-top:24px}.course-voucher-art .voucher-photo{width:100%;height:100%;object-fit:cover;object-position:48% 50%}
@media(max-width:450px){.voucher-paper{padding:19px}.voucher-label{margin-top:27px;font-size:8px}.voucher-paper strong{font-size:45px}.voucher-value{margin-top:24px;padding-top:12px}.voucher-value span:first-child{font-size:20px}.voucher-paper small{font-size:6px}.voucher-for{font-size:13px}}
</style>
