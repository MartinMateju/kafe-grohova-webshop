---
import type { Product } from '../lib/shopify';
import {
  bookableVariants,
  formatDateTime,
  formatDuration,
  formatMoney,
  imageUrl,
} from '../lib/shopify';
import { localePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  product: Product;
  lang: Lang;
  layout?: 'row' | 'tile';
}

const { product, lang, layout = 'row' } = Astro.props;
const t = useTranslations(lang);

const href = localePath(lang, `/courses/${product.handle}`);
const src = imageUrl(product.featuredImage?.url, 1000);
const price = formatMoney(product.priceRange.minVariantPrice, lang);
const open = bookableVariants(product);
const nextDates = open.slice(0, 3);
const duration = formatDuration(product.course?.durationMinutes ?? null, lang);
---

<article
  data-course-card={product.handle}
  class:list={['flex flex-col border border-ink/20 bg-white/25', layout === 'row' && 'md:flex-row']}
>
  <a href={href} class:list={['relative overflow-hidden group', layout === 'row' && 'md:w-2/5 md:shrink-0']}>
    {
      src ? (
        <img
          src={src}
          alt={product.featuredImage?.altText ?? product.title}
          loading="lazy"
          decoding="async"
          class:list={['h-64 w-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.03]', layout === 'row' && 'md:absolute md:inset-0 md:h-full']}
        />
      ) : (
        <div class:list={['h-64 w-full bg-stone', layout === 'row' && 'md:absolute md:inset-0 md:h-full']} />
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-4 p-5 md:p-7">
    <div class="flex flex-wrap gap-2 text-[11px] tracking-wide">
      {product.course?.capacity && <span data-course-capacity class="bg-ink px-3 py-1.5 text-cream">{t('courses.maxParticipants').replace('{n}', String(product.course.capacity))}</span>}
      {open.length > 0 && <span class="border border-brick/30 px-3 py-1.5 text-brick">{t('courses.openDates')}</span>}
    </div>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h3 class="text-[22px] leading-tight md:text-[26px]"><a href={href} class="hover:text-brick">{product.title}</a></h3>
      <p class="whitespace-nowrap text-[18px]">
        <span class="text-ink/50 text-[13px]">{t('courses.from')}</span>
        {price}
      </p>
    </div>

    <p class="text-[15px] leading-relaxed text-ink/80 md:text-[17px]">
      {product.description}
    </p>

    <dl class="flex flex-wrap gap-x-8 gap-y-2 text-[13px] text-ink/60">
      {
        duration && (
          <div>
            <dt class="label inline">{t('courses.duration')}: </dt>
            <dd class="inline">{duration}</dd>
          </div>
        )
      }
      {
        product.course?.level && (
          <div>
            <dt class="label inline">{t('courses.level')}: </dt>
            <dd class="inline">{product.course.level}</dd>
          </div>
        )
      }
    </dl>

    <div class="mt-auto flex flex-wrap items-center gap-3 pt-2">
      {
        nextDates.length > 0 ? (
          nextDates.map((v) => {
            const qty = v.quantityAvailable;
            const low = typeof qty === 'number' && qty > 0 && qty < 4;
            return (
              <span class="border border-ink/25 px-3 py-1.5 text-[13px]">
                {v.startsAt ? formatDateTime(v.startsAt, lang) : v.title}
                {low && <span class="ml-2 text-brick">· {qty}</span>}
              </span>
            );
          })
        ) : (
          <span class="text-[13px] text-ink/50">{t('courses.noDates')}</span>
        )
      }
      {
        open.length > nextDates.length && (
          <span class="text-[13px] text-ink/50">+{open.length - nextDates.length}</span>
        )
      }
    </div>

    <a
      href={href}
      class="mt-2 inline-block self-start border border-brick bg-brick px-6 py-3 text-[13px] tracking-widest text-cream transition-colors hover:border-ink hover:bg-ink"
    >
      {open.length > 0 ? t('courses.book') : t('courses.allCourses')}
    </a>
  </div>
</article>
