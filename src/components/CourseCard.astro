---
import type { Product } from '../lib/shopify';
import { formatDuration, formatMoney, imageUrl } from '../lib/shopify';
import { firstBookableCourseVariant, isComingSoonCourse, isLatteArtCourse } from '../lib/coursePresentation';
import { localePath, type Lang } from '../i18n/utils';
interface Props { product: Product; lang: Lang; layout?: 'row' | 'tile' }
const { product, lang } = Astro.props;
const cs = lang === 'cs';
const pending = isComingSoonCourse(product);
const next = firstBookableCourseVariant(product);
const latte = isLatteArtCourse(product);
const href = localePath(lang, '/courses/' + product.handle);
const image = latte ? '/photos/latte-pour.webp' : imageUrl(product.featuredImage?.url, 1000);
---
<article data-course-card={product.handle} class="course-feature">
  <a href={href} class="course-feature-photo"><img src={image} alt={latte ? (cs ? 'Příprava latte art v Kafe Grohova.' : 'Pouring latte art at Kafe Grohova.') : product.featuredImage?.altText ?? product.title} width="960" height="1440" loading="lazy" /></a>
  <div class="course-feature-copy">
    <p class="section-kicker">{pending ? (cs ? 'Připravujeme' : 'Coming soon') : (cs ? '01 / Za barem poprvé' : '01 / Your first pour')}</p>
    <h2 class="course-feature-title"><a href={href}>{latte ? (cs ? 'Latte art pro začátečníky.' : 'Latte art for beginners.') : product.title}</a></h2>
    <p class="course-feature-intro">{latte ? (cs ? 'Od první konvičky k prvnímu srdci. Prostor ptát se, zkoušet a nalévat znovu.' : 'From your first pitcher to your first heart. Room to ask, practise and pour again.') : product.description}</p>
    {!pending && <dl class="course-facts">
      {product.course?.durationMinutes && <div><dt>{cs ? 'Délka' : 'Duration'}</dt><dd>{formatDuration(product.course.durationMinutes, lang)}</dd></div>}
      {product.course?.capacity && <div><dt>{cs ? 'Malá skupina' : 'Small group'}</dt><dd data-course-capacity>{cs ? 'Max. ' : 'Up to '}{product.course.capacity}{cs ? ' účastníci' : ' people'}</dd></div>}
      {next && <div><dt>{cs ? 'Cena za osobu' : 'Per person'}</dt><dd>{formatMoney(next.price, lang)}</dd></div>}
    </dl>}
    <a href={href} class="course-text-link">{pending ? (cs ? 'O připravovaném kurzu' : 'About the upcoming course') : (cs ? 'Prohlédnout kurz' : 'Explore the course')} <span aria-hidden="true">↗</span></a>
  </div>
</article>
<style>
.course-feature{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid #29211d35;gap:clamp(24px,6vw,90px);padding-top:30px}
.course-feature-photo{display:block;overflow:hidden;min-height:420px}.course-feature-photo img{width:100%;height:100%;max-height:660px;object-fit:cover;object-position:50% 55%}
.course-feature-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:25px 0}.course-feature-title{font-family:Arial,Helvetica,sans-serif;font-size:clamp(36px,4.4vw,70px);font-weight:800;line-height:1.02;letter-spacing:-.055em;margin:24px 0}.course-feature-intro{max-width:420px;font:18px/1.6 Arial,sans-serif}
.course-facts{display:flex;flex-wrap:wrap;gap:22px 32px;margin:32px 0;width:100%;padding:24px 0;border-block:1px solid #29211d35}.course-facts dt{font-size:11px;text-transform:uppercase;letter-spacing:.07em;margin-bottom:8px}.course-facts dd{font-size:20px}.course-text-link{display:inline-flex;gap:45px;align-items:center;border-bottom:1px solid currentColor;padding:14px 0;font-size:13px;text-transform:uppercase;letter-spacing:.05em}.course-text-link span{font:25px Arial}
@media(max-width:700px){.course-feature{grid-template-columns:1fr;gap:0}.course-feature-photo{min-height:0;height:420px}.course-feature-copy{padding:30px 0}.course-feature-title{font-size:42px}.course-facts{gap:22px}}
</style>
