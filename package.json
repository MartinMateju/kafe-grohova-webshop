{
  "name": "kafe-grohova-webshop",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Astro storefront for Kafe Grohova — barista courses and merchandise, powered by Shopify",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts src/lib/shopify/shopify.test.mjs",
    "test:e2e": "playwright test",
    "catalog:generate": "node scripts/generate-demo-catalog.mjs",
    "shopify:verify": "tsx scripts/verify-shopify.ts",
    "validate": "npm run check && npm test && npm run build",
    "astro": "astro"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^5.18.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
