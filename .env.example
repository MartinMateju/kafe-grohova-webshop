# ---------------------------------------------------------------------------
# Shopify Storefront API
# ---------------------------------------------------------------------------
# Leave BOTH of these unset to run the site in MOCK MODE: all product, course
# and blog data comes from src/lib/shopify/mock.ts so you can develop the whole
# storefront before a Shopify store exists.
#
# To go live:
#   1. Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   2. Create an app -> Configuration -> Storefront API -> configure scopes:
#        unauthenticated_read_product_listings
#        unauthenticated_read_product_inventory   <- required for course seats
#        unauthenticated_read_content             <- required for the blog
#        unauthenticated_write_checkouts
#        unauthenticated_read_checkouts
#   3. Install the app, then copy the Storefront API access token below.
#
# The Storefront access token is designed to be public (it is used from the
# browser for cart operations). Do NOT put an Admin API token here.
PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API version to pin against.
PUBLIC_SHOPIFY_API_VERSION=2025-07

# ---------------------------------------------------------------------------
# Shopify content handles
# ---------------------------------------------------------------------------
# Collection handle holding barista course products (one variant per date).
PUBLIC_SHOPIFY_COURSES_COLLECTION=barista-kurzy
# Collection handle holding merchandise.
PUBLIC_SHOPIFY_MERCH_COLLECTION=merch
# Blog handle in Shopify (Online Store -> Blog posts).
PUBLIC_SHOPIFY_BLOG_HANDLE=news

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=https://kafegrohova.cz
