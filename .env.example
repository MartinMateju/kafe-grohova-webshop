# Kafe Grohova must use its OWN Shopify store, separate from the other shop.
# auto: demo only when both credentials are empty; live when both are supplied.
# demo: always fixtures, checkout disabled. live: credentials required.
PUBLIC_SHOPIFY_MODE=auto
# Merchandise is temporarily hidden. Set true and rebuild to restore it.
PUBLIC_MERCH_ENABLED=false
# Gift cards are independent of physical merchandise.
PUBLIC_GIFT_CARDS_ENABLED=true
# Dedicated Kafe Grohova store: b1pnun-1t.myshopify.com
PUBLIC_SHOPIFY_STORE_DOMAIN=
# PUBLIC Storefront access token from Shopify's Headless channel.
# Never use an Admin API token or PRIVATE Storefront token in PUBLIC_* variables.
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2026-07

PUBLIC_SHOPIFY_COURSES_COLLECTION=barista-kurzy
PUBLIC_SHOPIFY_MERCH_COLLECTION=merch
PUBLIC_SHOPIFY_BLOG_HANDLE=news

# Actual deployed storefront origin; used for canonical links and sitemap.
PUBLIC_SITE_URL=https://kafegrohova.cz
